{
  "name": "seoul-400km",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash ./build.sh",
    "build:html": "bash ./build.sh --html-only",
    "dev:web": "vite",
    "build:web": "vite build",
    "optimize:assets": "bash tools/optimize-embedded-assets.sh",
    "simulate:journeys": "python3 tools/simulate-journeys.py --runs 1000",
    "dev:toss": "granite dev",
    "prebuild:toss": "if [ \"${CARAVAN_HTML_READY:-0}\" != \"1\" ]; then bash ./build.sh --html-only; fi",
    "build:toss": "ait build && node tools/sync-ait-aliases.mjs",
    "lint:dialogue": "node tools/dialogue-lint.cjs",
    "validate:content": "node tools/validate-content.cjs",
    "verify:quick": "npm run lint:dialogue && npm run validate:content",
    "test:golden": "npm run build:html --silent && python3 tests/test_golden_route.py",
    "test:smoke": "npm run build:html --silent && python3 tests/test_smoke.py",
    "test:quality8": "npm run build:html --silent && python3 tests/test_quality_8_upgrade.py",
    "test:quality9": "npm run build:html --silent && python3 tests/test_quality_9_foundation.py",
    "test:quality9:audit": "node tools/quality-9-audit.cjs",
    "test:save": "npm run build:html --silent && python3 tests/test_save_migrations.py",
    "test:xss": "npm run build:html --silent && python3 tests/test_xss_guard.py",
    "test:pressure": "npm run build:html --silent && python3 tests/test_deadline_pressure.py",
    "test:combat": "npm run build:html --silent && python3 tests/test_combat_rework.py",
    "test:slots": "npm run build:html --silent && python3 tests/test_progression_slots.py",
    "test:determinism": "npm run build:html --silent && python3 tests/test_determinism.py",
    "test:eta": "npm run build:html --silent && python3 tests/test_eta_consistency.py",
    "test:choices": "npm run build:html --silent && python3 tests/test_choice_visibility.py",
    "test:beats": "npm run build:html --silent && python3 tests/test_journey_beats.py",
    "test:health": "python3 tests/test_source_health.py",
    "test:audio": "npm run build:html --silent && python3 tests/test_audio_mix.py",
    "test:finale": "npm run build:html --silent && python3 tests/test_finale.py",
    "simulate:engine": "python3 tools/simulate-engine.py --runs 60",
    "test:accessibility9": "npm run build:html --silent && python3 tests/test_quality_9_accessibility.py",
    "test:release": "bash tools/release-check.sh"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "2.10.6"
  },
  "devDependencies": {
    "vite": "8.1.5"
  }
}
