{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":6,"min":1377.3,"at":"muju","driving":null,"fuel":43.310226466666606,"fuelMax":70,"water":26,"waterMax":28,"food":18,"foodMax":24,"scrap":10,"van":74.83999999999945,"vanMax":100,"vanName":"달구지","items":{"부품":3,"의약품":1,"탄약":0,"남산행 편지":1,"할아버지의 봉투":1},"party":["leo"],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":100,"bond":23,"lvl":2,"perks":["leo_vip","leo_bori"],"pending":0,"approach":"wade","storyReady":true,"storyGateNotified":2},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":true,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong"],"visited":["busan","gimhae","jinju","namwon","damyang","gwangju","geochang","muju","jeonju"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"first_order_trace":true,"parent_signature_match":true,"postman_met":true,"postman_letter":true,"bridge_departure_echo":true,"bridge_trace_gap":true,"bridge_watched":true,"leo_approach_drive":true,"trace_registry":true,"parents_split_known":true,"parents_routes_traced":true,"parent_principle_found":true,"parent_key_located":true,"parent_cache_guarded":true,"jeonju_coldbag":true,"trace_dialect":true,"gp_envelope_found":true},"pursuit":0,"used":["ev_truck_cafe","onboarding_first_road","meet_postman","memory_busan_terminal","postman_again","salvage_claim","camp_thief","story_bridge_departure_echo","meet_hitchhiker","story_bridge_trace_gap","levy_office","rq_leo_task","story_bridge_watched","rq_leo_join","talk_leo_18","story_generation_form","jy_recruit","parents_diversion_manifest","crisis_nofuel","talk_leo_06","parents_separated_work","crisis_nofuel2","story_family_principle","story_family_key","crisis_nofuel3","talk_leo_13","story_personal_cache","story_generation_speech","gp_envelope"],"quest":null,"recruitQ":{"id":"jaeyi","stage":"task","target":"gimcheon","startedDay":3,"metAt":"muju","sameStop":false,"escort":true},"wx":"clear","wxNext":"fog","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"고철 연결 고리로 유나가 탄 이송 버스의 난방을 살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"옥상 커피나무","body":"북쪽 어느 옥상에서 커피를 재배하는 사람이 있다. 트럭 카페 주인 제보.","links":[],"day":1},{"id":"n11","type":"장소","title":"김해 들판","body":"DAY 1 도착. 민간 비행장이 있던 넓은 들판이다. 갈라진 활주로 위로 잡초가 길게 자라고, 북서쪽 유도로는 아직 바퀴가 지나갈 수 있다.","links":[],"day":1},{"id":"n12","type":"본편","title":"검문소 저장 모듈","body":"이송 대상을 다시 고르는 규칙과 부모님 이송표로 이어지는 검증 번호를 찾아냈다.","links":["부모님","천리안","남산"],"day":1},{"id":"n13","type":"소문","title":"남산으로 간 수신인","body":"우편부의 명단 속 한 사람. 마지막 소문은 남산 방향.","links":["남산"],"day":1},{"id":"n14","type":"장소","title":"진주 남강변","body":"DAY 1 도착. 강물은 그대로인데 다리는 반쪽이다. 유등 축제의 등롱 잔해가 강가에 쌓여 있다.","links":[],"day":1},{"id":"n15","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n16","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n17","type":"소문","title":"남산행 편지","body":"우편부의 마지막에서 두 번째 편지. 수신인은 남산 아래 김OO. \"오래 걸렸다고는 말고.\"","links":["남산"],"day":1},{"id":"n18","type":"장소","title":"남원 광한루","body":"DAY 1 도착. 무너진 누각 옆에서 누군가 판소리를 연습하고 있었다는 소문.","links":[],"day":1},{"id":"n19","type":"사건","title":"구역이라는 말","body":"무너진 창고 앞에서 회수료를 냈다. 남은 물건보다 허가증이 비쌌다.","links":[],"day":1},{"id":"n20","type":"장소","title":"담양 대숲","body":"DAY 1 도착. 대나무 숲이 바람마다 파도 소리를 낸다. 바다에서 멀수록 크게.","links":[],"day":1},{"id":"n21","type":"장소","title":"광주 대인시장","body":"DAY 2 도착. 호남 최대의 정착지. 시장 골목엔 아직 기름 냄새와 정이 흐른다.","links":[],"day":2},{"id":"n22","type":"사건","title":"대인시장의 발전기 줄","body":"세 발전기가 벨트 하나를 나눠 쓰는 시장의 교대 순서를 돕고 예비 풀리 하나를 받았다.","links":["광주 대인시장","달구지"],"day":2},{"id":"n23","type":"인물","title":"레오와 보리","body":"광주 대인시장에서 만난 떠돌이 가수와 개. 남원 쪽 침수 지하차도의 목소리를 확인하려 한다.","links":["레오","광주 대인시장"],"day":2},{"id":"n24","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n25","type":"사건","title":"가짜 행정소","body":"관공서를 흉내 낸 통행세 사기. 꺼진 태블릿을 가리키자 물러섰다. 다음 차는 속을지도 모른다.","links":[],"day":2},{"id":"n26","type":"사건","title":"보리를 데리러 돌아간 길","body":"같이 물에 들어가 보리를 구했다. 끊긴 노래는 엉망인 합창으로 이어졌다.","links":["레오","보리"],"day":2},{"id":"n27","type":"장소","title":"거창 분지","body":"DAY 2 도착. 산으로 둘러싸인 분지. 안개가 자주 고인다.","links":[],"day":2},{"id":"n28","type":"인물","title":"레오 · 노래 없는 자리","body":"완성된 노래 대신 쓰다 만 한 줄을 듣는다. 여분 기타 줄 끝에 쓰다 만 가사와 오늘 날짜를 묶었다. 완성하기 전에 들려준 첫 줄이다.","links":["레오","달구지"],"day":2},{"id":"n29","type":"인물","title":"레오","body":"떠나기 전의 일을 함께 끝낸 뒤 달구지에 합류했다. 함께 물에 들어갔다. 말도 안 맞던 합창 한 소절을 레오가 자꾸 웃으며 흥얼거린다. 기타 하나, 개 한 마리. 세상이 끝났는데도 신곡을 쓴다. 개 이름은 보리.","links":[],"day":3},{"id":"n30","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":3},{"id":"n31","type":"장소","title":"무주 터널","body":"DAY 3 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":3},{"id":"n32","type":"인물","title":"재이","body":"무주 터널에서 만난 수집꾼. 김천 재활용 창고에 깔린 가족 상자를 되찾아야 한다.","links":["재이","무주 터널"],"day":3},{"id":"n33","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 300km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n34","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":3},{"id":"n35","type":"인물","title":"레오 · 먼저 비워 둔 자리","body":"가사 대신 오늘 들은 바퀴 소리를 흉내 낸다. 수첩의 쓰다 만 가사 옆에 둘이 두드린 박자를 표시했다.","links":["레오","달구지"],"day":3},{"id":"n36","type":"인물","title":"직업 정신","body":"무서움을 감추려고 웃는다. 첫 공연 때 웃어 준 관객 한 명을 기억하고 있었다.","links":["레오"],"day":4},{"id":"n37","type":"사건","title":"두 곳에서 만든 한 절차","body":"아버지가 남산 유지선에 분리 절차를 나누어 숨겼음을 확인했다.","links":[],"day":4},{"id":"n38","type":"사건","title":"예측은 명령이 아니다","body":"부모님의 발표 연습 영상에서 엄마의 발언을 복원했다. 천리안은 사람을 미래 파급으로 평가했고, 부모는 이유 공개·인간 서명·이의 제기를 되돌리려 했다.","links":["천리안","부모님의 검증키"],"day":4},{"id":"n39","type":"사건","title":"실행 전 인간 확인","body":"달구지 계기판의 숨은 모듈을 확인하고 배선 위치를 표시했다. 뜯긴 분리 절차를 찾을 때까지 그대로 보존한다.","links":["천리안","할아버지"],"day":4},{"id":"n40","type":"인물","title":"레오 · 기타 옆의 두 사람","body":"레오와 오늘 들은 소리로 박자를 맞춘다. 레오와 번갈아 박자를 두드렸다. 순서를 잊자 다시 시작하는 대신 둘 다 웃었다.","links":["레오","달구지"],"day":5},{"id":"n41","type":"인물","title":"데뷔 성적표","body":"\"슬퍼서 운 거 아니래요\" — 레오가 음악을 계속하는 이유의 전문.","links":["레오"],"day":6},{"id":"n42","type":"사건","title":"운전 숙련: 로드마스터","body":"누적 주행 440km. 로드마스터 — 할아버지가 스스로를 그렇게 불렀다. 이제 그 이름이 내 것이 됐다.","links":["할아버지"],"day":6},{"id":"n43","type":"사건","title":"부모님이 감춘 상자","body":"부모님의 원본은 지키고 단서만 장부에 베꼈다.","links":[],"day":6},{"id":"n44","type":"장소","title":"전주 서문 시장","body":"DAY 6 도착. 서쪽 최대 정착지. 음식 냄새가 나는 마지막 도시.","links":[],"day":6},{"id":"n45","type":"세대의 흔적","title":"문 앞에 놓인 국밥","body":"2026년 배달 가방이 세대를 지나 아픈 집에 국밥을 나르는 공동 가방으로 쓰였다.","links":["전주 서문 시장","2026년"],"day":6},{"id":"n46","type":"사건","title":"사람 안의 서울","body":"서울을 본 적 없는 아이는 서울이 어디냐는 질문에 자기 할머니를 가리켰다.","links":["서울 추방"],"day":6},{"id":"n47","type":"사건","title":"이중 봉투","body":"\"아직 남산 아니지 않냐.\" 손주를 정확히 아는 이중 포장. 속봉투는 남산까지.","links":["할아버지","남산"],"day":6}],"noteSeq":48,"npcs":{"geumja":{"att":4,"met":false,"chat":[]},"sundeok":{"att":0,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":4,"met":false,"chat":[]},"miyoung":{"att":12,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":524.0000000000025,"events":29,"nonlethal":0},"routePlan":null,"thirst":0,"hunger":0,"ended":false,"seed":901257,"fatigue":61.22110999999999,"_dlv":4,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":6,"_lunchDay":6,"_storyQue