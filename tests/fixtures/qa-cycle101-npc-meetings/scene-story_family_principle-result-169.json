":true,"story_chain_relay_2":true,"recall_blocked":true,"toll_left_armed":true,"parents_split_known":true,"parents_routes_traced":true,"parent_principle_found":true},"pursuit":5,"used":["lc_busan_dried","meet_postman","onboarding_first_road","hist_bus_driver_badge","memory_busan_terminal","story_bridge_departure_echo","camp_thief","story_bridge_trace_gap","levy_office","salvage_claim","story_bridge_watched","perimeter_first","story_generation_form","cleaners_recall","patrol_toll","combat_toll_read","combat_toll_breach","parents_diversion_manifest","parents_separated_work","story_family_principle"],"quest":{"kind":"deliver","item":"세 마을의 교대 장부","from":"daejeon","to":"miryang","reward":24,"due":102,"noExpiry":true,"ledgerId":"story_relay_3","story":{"id":"relay","title":"세 마을의 무전","stage":3,"total":3,"origin":"miryang","visited":["miryang","jeonju","daejeon"],"prompt":"이제 세 곳이 같은 시간에 무전을 들을 수 있어요. 처음 부탁한 사람에게 교대 장부를 돌려주면 됩니다.","completion":"떨어져 있던 세 마을이 아침과 저녁에 같은 주파수를 듣기 시작했다."}},"recruitQ":null,"wx":"clear","wxNext":"dust","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"부산에서 막힌 이의 제기","body":"도윤 가족의 이송표와 원격 이의 거절 응답을 함께 복사했다. 현장 확인 주소는 남산 중앙 노드였다.","links":["도윤의 가족","남산","천리안"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"사건","title":"자갈치 건어물","body":"\"마른 것들은 배신 안 한데이.\" 부산의 마지막 배웅.","links":[],"day":1},{"id":"n11","type":"인물","title":"자전거 우편부","body":"주소 대신 이름과 얼굴로 배달한다. 여러 해째 수신인을 찾는 중.","links":[],"day":1},{"id":"n12","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"마지막 승인자의 명찰","body":"초기 대중교통망은 천리안의 추천 뒤에 인간 관제사의 이름과 승인 시각을 남겼다.","links":["천리안","대중교통"],"day":1},{"id":"n15","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n16","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n17","type":"소문","title":"의뢰: 세 마을의 무전 1/3 · 끊긴 중계소의 호출 장부","body":"밀양 장터에서 맡은 연속 이야기. 전주 서문 시장까지. 사례는 고철 16. 서두르기보다 끝까지 이어 가기로 했다.","links":["전주 서문 시장"],"day":1},{"id":"n18","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n19","type":"세대의 흔적","title":"2026년 교통카드 번호표","body":"대중교통을 타던 카드는 143년 뒤 밀양 장터의 국수 대기 번호표가 되었다. 기능은 잊혔지만 차례를 지키는 용도만은 남았다.","links":["밀양 장터","2026년"],"day":1},{"id":"n20","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n21","type":"장소","title":"합천 과수원","body":"DAY 1 도착. 주인 잃은 사과나무들이 제멋대로 열매를 맺는다.","links":[],"day":1},{"id":"n22","type":"장소","title":"거창 분지","body":"DAY 2 도착. 산으로 둘러싸인 분지. 안개가 자주 고인다.","links":[],"day":2},{"id":"n23","type":"장소","title":"남원 광한루","body":"DAY 2 도착. 무너진 누각 옆에서 누군가 판소리를 연습하고 있었다는 소문.","links":[],"day":2},{"id":"n24","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 181km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n25","type":"장소","title":"전주 서문 시장","body":"DAY 2 도착. 서쪽 최대 정착지. 음식 냄새가 나는 마지막 도시.","links":[],"day":2},{"id":"n26","type":"사건","title":"배달 완료: 세 마을의 무전 1/3 · 끊긴 중계소의 호출 장부","body":"밀양 장터 → 전주 서문 시장. 사례 고철 16. 받은 이의 얼굴이 밝아졌다.","links":[],"day":2},{"id":"n27","type":"소문","title":"의뢰: 세 마을의 무전 2/3 · 확인된 주파수표","body":"전주 서문 시장에서 맡은 연속 이야기. 대전 연구단지까지. 사례는 고철 20. 서두르기보다 끝까지 이어 가기로 했다.","links":["대전 연구단지"],"day":2},{"id":"n28","type":"장소","title":"논산 평야","body":"DAY 2 도착. 끝없는 논. 허수아비들이 아직 서 있다. 어떤 것은 방향이 바뀌어 있다.","links":[],"day":2},{"id":"n29","type":"사건","title":"첫 경고사격","body":"위수 구역의 경고탄에 튄 파편이 차 외판을 상하게 했다. 뒤 칸의 고철과 공구를 손 닿는 곳으로 옮겼다.","links":["천리안"],"day":2},{"id":"n30","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":3},{"id":"n31","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 301km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n32","type":"장소","title":"대전 연구단지","body":"DAY 3 도착. 과학자들의 코뮌. 천리안을 가장 잘 아는 사람들이 남아 있다.","links":[],"day":3},{"id":"n33","type":"사건","title":"특송 완료: 세 마을의 무전 2/3 · 확인된 주파수표","body":"전주 서문 시장 → 대전 연구단지. 사례 고철 20. 받은 이의 얼굴이 밝아졌다.","links":[],"day":3},{"id":"n34","type":"소문","title":"의뢰: 세 마을의 무전 3/3 · 세 마을의 교대 장부","body":"대전 연구단지에서 맡은 연속 이야기. 밀양 장터까지. 사례는 고철 24. 서두르기보다 끝까지 이어 가기로 했다.","links":["밀양 장터"],"day":3},{"id":"n35","type":"사건","title":"기도하는 포위","body":"회수조는 기도하다 물러났고, 여자는 차에서 내려 혼자 들길로 갔다. 차로 돌아와도 기도 소리가 귓가에 남았다.","links":["정리자들"],"day":3},{"id":"n36","type":"장소","title":"영동 포도밭","body":"DAY 3 도착. 야생화된 포도넝쿨이 도로까지 점령했다.","links":[],"day":3},{"id":"n37","type":"사건","title":"교전 기록: 자동 검문소","body":"지형: 안개 낀 배수로와 수동 제어함\n처음 목표: 송신 전에 차단봉을 열고 기록 없이 통과한다\n실패 위험: 차량 번호가 중앙 검문 기록에 남는다\n읽어낸 틈: 센서 점등부터 송신까지 여섯 초\n정찰 — 잠입: 배수로를 따라 제어함까지 붙는다\n대응 — 관찰: 점등 순서를 한 바퀴 더 지켜본다\n돌파 — 이탈: 작업을 버리고 논길로 물러난다\n결과: 부분 달성. 차체 80/100, 관측 5/5.","links":["달구지","천리안"],"day":3},{"id":"n38","type":"사건","title":"돌아서 나온 검문소","body":"검문소 작업을 중단하고 물러났다. 붉은 불이 등을 훑었고 시도는 기록으로 남았다.","links":["천리안"],"day":3},{"id":"n39","type":"장소","title":"무주 터널","body":"DAY 3 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":3},{"id":"n40","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":3},{"id":"n41","type":"사건","title":"운전 숙련: 로드마스터","body":"누적 주행 440km. 로드마스터 — 할아버지가 스스로를 그렇게 불렀다. 이제 그 이름이 내 것이 됐다.","links":["할아버지"],"day":3},{"id":"n42","type":"사건","title":"두 곳에서 만든 한 절차","body":"아버지가 남산 유지선에 분리 절차를 나누어 숨겼음을 확인했다.","links":[],"day":3},{"id":"n43","type":"사건","title":"인과의 점으로 분류된 사람들","body":"천리안은 사람을 미래 결과의 고위험·고효율 노드로 분류했다. 엄마는 그 계산이 권리를 대신할 수 없다고 남겼다.","links":["천리안","부모님의 검증키"],"day":4}],"noteSeq":44,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":12,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":10,"met":false,"chat":[]},"drhan":{"att":9,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":6,"met":false,"chat":[]},"noah":{"att":9,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":488.45500000000396,"events":20,"nonlethal":0},"routePlan":null,"thirst":0,"hunger":0,"ended":false,"seed":1001207,"fatigue":7.88766,"_dlv":4,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay