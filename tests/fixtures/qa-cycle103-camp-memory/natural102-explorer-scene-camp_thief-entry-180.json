{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":4,"min":390,"at":"nonsan","driving":null,"fuel":52.50352499999968,"fuelMax":70,"water":11,"waterMax":28,"food":8,"foodMax":24,"scrap":70,"van":86.43999999999984,"vanMax":100,"vanName":"달구지","items":{"부품":4,"의약품":1,"탄약":0},"party":[],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong"],"visited":["busan","yangsan","miryang","daegu","gumi","gimcheon","sangju","mungyeong","chungju","cheongju","daejeon","nonsan"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"miryang_oldcard":true,"bridge_departure_echo":true,"story_chain_relay_1":true,"bridge_trace_gap":true,"route_ridge_saved":true,"bridge_watched":true,"trace_registry":true,"armed_age":true,"toll_left_armed":true,"daejeon_deployment_card":true,"parents_split_known":true},"pursuit":4,"used":["lc_busan_dried","meet_postman","onboarding_first_road","memory_busan_terminal","story_bridge_departure_echo","story_bridge_trace_gap","levy_office","route_mid_fork","salvage_claim","route_ridge_rescue","route_ridge_anchor","route_ridge_extract","story_bridge_watched","loc_mungyeong","story_generation_form","perimeter_first","patrol_toll","combat_toll_read","combat_toll_breach","parents_diversion_manifest","camp_thief"],"quest":{"kind":"express","item":"확인된 주파수표","from":"daegu","to":"jeonju","reward":20,"due":101,"noExpiry":true,"ledgerId":"story_relay_2","story":{"id":"relay","title":"세 마을의 무전","stage":2,"total":3,"origin":"miryang","visited":["miryang","daegu","jeonju"],"prompt":"장부에 적힌 호출 시간은 이제 안 써요. 새 주파수표를 드릴게요. 아직 듣고 있는 곳이 하나 더 있으니 그곳에도 전해 주세요.","completion":"떨어져 있던 세 마을이 아침과 저녁에 같은 주파수를 듣기 시작했다."}},"recruitQ":null,"wx":"clear","wxNext":"clear","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"부산에서 막힌 이의 제기","body":"도윤 가족의 이송표와 원격 이의 거절 응답을 함께 복사했다. 현장 확인 주소는 남산 중앙 노드였다.","links":["도윤의 가족","남산","천리안"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"사건","title":"자갈치 건어물","body":"\"마른 것들은 배신 안 한데이.\" 부산의 마지막 배웅.","links":[],"day":1},{"id":"n11","type":"인물","title":"자전거 우편부","body":"주소 대신 이름과 얼굴로 배달한다. 여러 해째 수신인을 찾는 중.","links":[],"day":1},{"id":"n12","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n16","type":"소문","title":"의뢰: 세 마을의 무전 1/3 · 끊긴 중계소의 호출 장부","body":"밀양 장터에서 맡은 연속 이야기. 대구 돔 시장까지. 사례는 고철 16. 서두르기보다 끝까지 이어 가기로 했다.","links":["대구 돔 시장"],"day":1},{"id":"n17","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n18","type":"세대의 흔적","title":"2026년 교통카드 번호표","body":"대중교통을 타던 카드는 143년 뒤 밀양 장터의 국수 대기 번호표가 되었다. 기능은 잊혔지만 차례를 지키는 용도만은 남았다.","links":["밀양 장터","2026년"],"day":1},{"id":"n19","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n20","type":"장소","title":"대구 돔 시장","body":"DAY 1 도착. 야구장 지붕 아래 남부 최대의 시장이 산다.","links":[],"day":1},{"id":"n21","type":"사건","title":"배달 완료: 세 마을의 무전 1/3 · 끊긴 중계소의 호출 장부","body":"밀양 장터 → 대구 돔 시장. 사례 고철 16. 받은 이의 얼굴이 밝아졌다.","links":[],"day":2},{"id":"n22","type":"소문","title":"의뢰: 세 마을의 무전 2/3 · 확인된 주파수표","body":"대구 돔 시장에서 맡은 연속 이야기. 전주 서문 시장까지. 사례는 고철 20. 서두르기보다 끝까지 이어 가기로 했다.","links":["전주 서문 시장"],"day":2},{"id":"n23","type":"장소","title":"구미 공단 폐허","body":"DAY 2 도착. 멈춘 공장들. 굴뚝 하나에서 이유 모를 연기가 오른다.","links":[],"day":2},{"id":"n24","type":"사건","title":"가짜 행정소","body":"관공서를 흉내 낸 통행세 사기. 꺼진 태블릿을 가리키자 물러섰다. 다음 차는 속을지도 모른다.","links":[],"day":2},{"id":"n25","type":"장소","title":"김천 갈림길","body":"DAY 2 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":2},{"id":"n26","type":"사건","title":"김천에서 고른 길: 동쪽 능선길","body":"약 130km · 빠르지만 험로가 많고, 구조할 사람을 외면하기 어렵다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":2},{"id":"n27","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n28","type":"장소","title":"상주 자전거길","body":"DAY 2 도착. 자전거의 도시. 기름 없는 세상에서 뒤늦게 전성기를 맞았다.","links":[],"day":2},{"id":"n29","type":"사건","title":"구조 기록: 비탈에 걸린 우편 수레","body":"지형: 젖은 절개지와 무너진 돌망\n처음 목표: 네 사람을 도로로 올린다\n실패 위험: 비탈이 다시 움직이기 전에 끝내야 한다\n읽어낸 틈: 사람 줄과 짐 줄을 나눌 발판\n멈춰 세우기 — 고정: 달구지를 바위 뒤에 걸고 견인줄을 내린다\n길 만들기 — 토공: 삽으로 하중을 나눌 계단을 판다\n꺼내기 — 분리 인양: 사람과 수레에 줄을 다시 걸어 나눠 당긴다\n결과: 목표 달성. 차체 86/100, 관측 1/5.","links":["달구지","천리안"],"day":2},{"id":"n30","type":"사건","title":"능선 아래 네 사람","body":"달구지를 닻으로 삼아 네 사람과 문경행 해열제를 함께 올렸다.","links":["달구지"],"day":2},{"id":"n31","type":"장소","title":"문경새재","body":"DAY 2 도착. 과거 보러 넘던 옛 고개. 지금도 넘는 자에게 뭔가를 시험한다.","links":[],"day":2},{"id":"n32","type":"사건","title":"새재의 나무판","body":"\"지금 넘는 당신은 무엇을 보러 가는가.\" 한 단어를 적었다. 뜻은 적은 사람만 안다.","links":["할아버지"],"day":2},{"id":"n33","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":2},{"id":"n34","type":"장소","title":"충주호","body":"DAY 2 도착. 거대한 호수는 그대로다. 물안개 너머로 낚싯배 하나가 느리게 지나간다.","links":[],"day":2},{"id":"n35","type":"사건","title":"첫 경고사격","body":"위수 구역의 경고탄에 튄 파편이 차 외판을 상하게 했다. 뒤 칸의 고철과 공구를 손 닿는 곳으로 옮겼다.","links":["천리안"],"day":2},{"id":"n36","type":"사건","title":"교전 기록: 자동 검문소","body":"지형: 안개 낀 배수로와 수동 제어함\n처음 목표: 송신 전에 차단봉을 열고 기록 없이 통과한다\n실패 위험: 차량 번호가 중앙 검문 기록에 남는다\n읽어낸 틈: 시점 추적이 미세하게 어긋남\n정찰 — 잠입: 배수로를 따라 제어함까지 붙는다\n대응 — 관찰: 점등 순서를 한 바퀴 더 지켜본다\n돌파 — 이탈: 작업을 버리고 논길로 물러난다\n결과: 부분 달성. 차체 82/100, 관측 4/5.","links":["달구지","천리안"],"day":3},{"id":"n37","type":"사건","title":"돌아서 나온 검문소","body":"검문소 작업을 중단하고 물러났다. 붉은 불이 등을 훑었고 시도는 기록으로 남았다.","links":["천리안"],"day":3},{"id":"n38","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 300km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n39","type":"장소","title":"청주 방송국","body":"DAY 3 도착. 송신탑이 꺾인 채 서 있다. 마지막 방송이 뭐였는지 아는 사람은 없다.","links":[],"day":3},{"id":"n40","type":"사건","title":"노선 완주: 동쪽 능선길","body":"김천에서 고른 길을 청주까지 바꾸지 않고 왔다. 시간을 아끼고 산길 사람들의 통행로를 되살린다.","links":["달구지"],"day":3},{"id":"n41","type":"장소","title":"대전 연구단지","body":"DAY 3 도착. 과학자들의 코뮌. 천리안을 가장 잘 아는 사람들이 남아 있다.","links":[],"day":3},{"id":"n42","type":"세대의 흔적","title":"미설치된 마지막 칸","body":"2026년 TIANYAN 배포 카드에서 교통·의료·전력·행정은 설치됐지만 강제 명령 인간 확인은 비어 있었다.","links":["대전 연구단지 코뮌","천리안","2026년"],"day":3},{"id":"n43","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":3},{"id":"n44","type":"장소","title":"논산 평야","body":"DAY 3 도착. 끝없는 논. 허수아비들이 아직 서 있다. 어떤 것은 방향이 바뀌어 있다.","links":[],"day":3}],"noteSeq":45,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":12,"met":true,"chat":[]},"taeho":{"att":6,"met":false,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":12,"met":true,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":6,"met":false,"chat":[]},"mansu":{"att":6,"met":false,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":374.00000000000273,"events":24,"nonlethal":1},"routePlan":{"id":"ridge","status":"complete","chosenDay":2,"startedKm":170,"visited":["gimcheon","sangju","mungyeong","chungju","cheongju"],"completedDay":3},"thirst":0,"hunger":0,"en