k","meet_postman","rq_kangwoo_join"],"quest":null,"recruitQ":{"id":"kangwoo","stage":"ready","target":"gumi","startedDay":2,"metAt":"daegu","sameStop":true,"escort":true,"choice":"follow","choiceDay":2,"roadFrom":"daegu","roadDay":2,"followDay":2,"readyDay":3},"wx":"clear","wxNext":"storm","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"고철 연결 고리로 유나가 탄 이송 버스의 난방을 살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n11","type":"본편","title":"첫 번째 발신 기록","body":"이송 대상은 배급망이 바뀔 때마다 자동으로 다시 정해진다. 부모님의 이송표와 같은 곳에서 발신된 명령이다.","links":["부모님","천리안","남산"],"day":1},{"id":"n12","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n13","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n14","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n15","type":"세대의 흔적","title":"2026년 교통카드 번호표","body":"대중교통을 타던 카드는 143년 뒤 밀양 장터의 국수 대기 번호표가 되었다. 기능은 잊혔지만 차례를 지키는 용도만은 남았다.","links":["밀양 장터","2026년"],"day":1},{"id":"n16","type":"인물","title":"민지","body":"밀양 부품 천막의 정비사. 달구지 소리만 듣고 느슨한 클램프를 찾아냈다.","links":["민지","밀양 장터"],"day":1},{"id":"n17","type":"소문","title":"순덕의 소문","body":"북쪽 호수에 낚시꾼 영감이 혼자 사는데, 지나가는 사람한테 민물고기를 나눠준다더군. 밀양서 산길로 조금만 올라가면 돼.","links":["낚시꾼의 호수","순덕"],"day":1},{"id":"n18","type":"소문","title":"병철의 소문","body":"강 상류에서 정리자들이 뭘 건져 올리더라. 흰 옷 넷이서, 밤에, 등도 없이. 건진 게 뭔지는 안 보이더라만— 사람 크기였다. 상류 쪽에선 밤낚시 하지 마라.","links":["병철"],"day":1},{"id":"n19","type":"소문","title":"영옥의 소문","body":"창녕 쪽 폐도로 옆에 해바라기 밭이 살아 있다 카더라. 씨 받으러 가는 사람들이 있어. 기름도 짜고. 눈 호강은 덤이고. 가을 전에 가 봐라.","links":["해바라기 밭","영옥"],"day":1},{"id":"n20","type":"장소","title":"낚시꾼의 호수","body":"DAY 1 도착. 댐 호수. 혼자 사는 낚시꾼이 물고기를 나눠준다는 소문.","links":[],"day":1},{"id":"n21","type":"사건","title":"호숫가 낚시","body":"낚시꾼과 오래 나란히 앉아 있었다. 낚싯대를 접으며 말린 생선 꾸러미를 받았다.","links":[],"day":2},{"id":"n22","type":"인물","title":"걷는 노인","body":"오랫동안 걸어서 전국을 도는 사람. \"걸으면 다 보여.\"","links":[],"day":2},{"id":"n23","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n24","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":2},{"id":"n25","type":"장소","title":"대구 돔 시장","body":"DAY 2 도착. 야구장 지붕 아래 남부 최대의 시장이 산다.","links":[],"day":2},{"id":"n26","type":"사건","title":"다시 켜진 돔 전광판","body":"경기장이던 돔의 전광판은 지금 물자 도착과 미아 이름을 알린다. 끊어진 배선을 고쳐 한 구역을 되살렸다.","links":["대구 돔 시장"],"day":2},{"id":"n27","type":"세대의 흔적","title":"돔의 좌석 번호","body":"야구장 입장권의 좌석 번호가 시장에서 가족을 다시 찾는 번호표로 남았다.","links":["대구 돔 시장","2026년"],"day":2},{"id":"n28","type":"인물","title":"강우","body":"\"버리는 차는 빨리 가고, 싣는 차는 끝까지 간다.\" 다만 그는 자기 자리를 빈 채로 만들지 않는다.","links":["강우","달구지"],"day":2},{"id":"n29","type":"사건","title":"경비탑의 다음 사람","body":"강우가 개입하지 않은 시간을 서연이 지켰다. 돔 시장에는 다음 파수꾼이 생겼다.","links":["강우"],"day":2},{"id":"n30","type":"소문","title":"태호의 소문","body":"구미 쪽 백화점 말이야, 다들 털렸다고 하는데 지하 창고는 아무도 못 열었대. 셔터가 내려져 있거든. 정비 도구가 있으면 얘기가 다르겠지만.","links":["유령 백화점","태호"],"day":2},{"id":"n31","type":"소문","title":"세라의 소문","body":"왜관 쪽 고속도로에 휴게소가 통째로 잠들어 있대요. 셔터 내린 그대로요. 호두과자 기계까지 그대로라던데— 믿거나 말거나. 지도에 표시해 드릴게요. 책 손님 특전.","links":["잠든 휴게소","세라"],"day":2},{"id":"n32","type":"소문","title":"만수의 소문","body":"구미 지나서 폐 자동차극장 하나 있다. 달 뜨면 스크린이 그렇게 하얗다 카더라. 나는 거기서 한 번 공연했지. 관객은 셋이었는데 박수는 삼십 명 몫을 치더라.","links":["달빛 자동차극장","만수"],"day":2},{"id":"n33","type":"소문","title":"우편부의 지름길","body":"물 반 잔의 답례. 어느 고개의 지름길.","links":[],"day":2},{"id":"n34","type":"장소","title":"구미 공단 폐허","body":"DAY 2 도착. 멈춘 공장들. 굴뚝 하나에서 이유 모를 연기가 오른다.","links":[],"day":2},{"id":"n35","type":"인물","title":"강우 · 문손잡이에서 손을 떼기","body":"내일의 경계를 나눠 맡고 쉴 순번도 적는다. 접힌 지도에 경계와 휴식 순번을 함께 적었다. 강우가 쉬는 칸도 있다.","links":["강우","달구지"],"day":2}],"noteSeq":36,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":17,"met":true,"chat":[]},"taeho":{"att":17,"met":true,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":5,"met":true,"chat":[]},"yeongok":{"att":5,"met":true,"chat":[]},"sera":{"att":5,"met":true,"chat":[]},"mansu":{"att":5,"met":true,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0