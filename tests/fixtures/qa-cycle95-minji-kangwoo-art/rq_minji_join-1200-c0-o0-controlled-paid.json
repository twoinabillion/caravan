{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":8,"min":1200,"at":"gyeongju","driving":null,"fuel":50,"fuelMax":70,"water":20,"waterMax":28,"food":20,"foodMax":24,"scrap":40,"van":90,"vanMax":100,"vanName":"달구지","items":{"부품":2,"의약품":1,"탄약":0,"쇠파이프":1},"party":[],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","lake","sunflower"],"visited":["busan","yangsan","miryang","ulsan","gyeongju"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"minji_request_heard":true,"miryang_oldcard":true,"rumor_sundeok":true,"rumor_byungchul":true,"rumor_yeongok":true,"bridge_departure_echo":true,"bridge_trace_gap":true,"minji_approach_drive":true},"pursuit":0,"used":["meet_postman","onboarding_first_road","memory_busan_terminal","meet_scrapyard","rq_minji_request","story_bridge_departure_echo","story_bridge_trace_gap","rq_minji_task","salvage_claim","loc_gyeongju","rq_minji_join"],"quest":null,"recruitQ":{"id":"minji","stage":"ready","target":"gyeongju","startedDay":2,"metAt":"miryang","sameStop":false,"escort":true,"choice":"pulley","choiceDay":2,"roadFrom":"ulsan","roadDay":2,"followDay":2,"readyDay":3},"wx":"clear","wxNext":"clear","up":{"collector":true},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"부산에서 막힌 이의 제기","body":"도윤 가족의 이송표와 원격 이의 거절 응답을 함께 복사했다. 현장 확인 주소는 남산 중앙 노드였다.","links":["도윤의 가족","남산","천리안"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"남산으로 간 수신인","body":"우편부의 명단 속 한 사람. 마지막 소문은 남산 방향.","links":["남산"],"day":1},{"id":"n11","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n12","type":"본편","title":"첫 번째 발신 기록","body":"이송 대상은 배급망이 바뀔 때마다 자동으로 다시 정해진다. 부모님의 이송표와 같은 곳에서 발신된 명령이다.","links":["부모님","천리안","남산"],"day":1},{"id":"n13","type":"사건","title":"부산 터미널의 마지막 불","body":"부산 터미널에서 부모님의 다음 차를 오래 기다렸다.","links":[],"day":1},{"id":"n14","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n15","type":"사건","title":"달구지 개조: 빗물 집수기","body":"매일 아침 물 +1 (비·폭풍 +2) · 지붕 자리 사용 — 달구지가 조금 더 우리 집이 됐다.","links":[],"day":1},{"id":"n16","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":2},{"id":"n17","type":"인물","title":"민지","body":"밀양 부품 천막의 정비사. 달구지 소리만 듣고 느슨한 클램프를 찾아냈다.","links":["민지","밀양 장터"],"day":2},{"id":"n18","type":"인물","title":"민지와 울산까지","body":"오빠의 목소리가 남아 있을지도 모르는 진단기. 민지와 함께 꺼내러 가기로 했다.","links":["민지","울산 공단"],"day":2},{"id":"n19","type":"세대의 흔적","title":"2026년 교통카드 번호표","body":"대중교통을 타던 카드는 143년 뒤 밀양 장터의 국수 대기 번호표가 되었다. 기능은 잊혔지만 차례를 지키는 용도만은 남았다.","links":["밀양 장터","2026년"],"day":2},{"id":"n20","type":"소문","title":"순덕의 소문","body":"북쪽 호수에 낚시꾼 영감이 혼자 사는데, 지나가는 사람한테 민물고기를 나눠준다더군. 밀양서 산길로 조금만 올라가면 돼.","links":["낚시꾼의 호수","순덕"],"day":2},{"id":"n21","type":"소문","title":"병철의 소문","body":"강 상류에서 정리자들이 뭘 건져 올리더라. 흰 옷 넷이서, 밤에, 등도 없이. 건진 게 뭔지는 안 보이더라만— 사람 크기였다. 상류 쪽에선 밤낚시 하지 마라.","links":["병철"],"day":2},{"id":"n22","type":"소문","title":"영옥의 소문","body":"창녕 쪽 폐도로 옆에 해바라기 밭이 살아 있다 카더라. 씨 받으러 가는 사람들이 있어. 기름도 짜고. 눈 호강은 덤이고. 가을 전에 가 봐라.","links":["해바라기 밭","영옥"],"day":2},{"id":"n23","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n24","type":"장소","title":"울산 공업탑","body":"DAY 2 도착. 멈춘 크레인들이 지평선을 이룬다. 세계에서 가장 조용한 공업도시.","links":[],"day":2},{"id":"n25","type":"사건","title":"무너지기 전의 목소리","body":"임시 도르래로 민규의 진단기를 구했다. 마지막 신호의 좌표를 확인할 길이 열렸다.","links":["민지","민규의 신호"],"day":2},{"id":"n26","type":"사건","title":"구역이라는 말","body":"무너진 창고 앞에서 회수료를 냈다. 남은 물건보다 허가증이 비쌌다.","links":[],"day":2},{"id":"n27","type":"장소","title":"경주 왕릉","body":"DAY 2 도착. 왕릉 사이에 텐트 몇 동. 천년을 버틴 언덕들은 멸망도 대수롭지 않아 한다.","links":[],"day":2},{"id":"n28","type":"사건","title":"왕릉 소풍","body":"경주 왕릉 아래서 마을 아이와 옥수수를 먹고 쉬었다.","links":[],"day":3}],"noteSeq":29,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":17,"met":true,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":5,"met":true,"chat":[]},"yeongok":{"att":5,"met":true,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":154.00000000000014,"events":11,"nonlethal":0},"routePlan":null,"thirst":0,"hunger":0,"ended":false,"seed":941147,"fatigue":10,"_dlv":1,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":2,"_lunchDay":2,"_storyQueue":[],"_recentEvents":["meet_postman","onboarding_first_road","memory_busan_terminal","meet_scrapyard","rq_minji_request","story_bridge_departure_echo","story_bridge_trace_gap","rq_minji_task","salvage_claim","loc_gyeongju","rq_minji_join"],"_recentEventTypes":["사건","추적","스토리","조우","탐색","스토리"],"_eventBreather":3,"_beatQueue":["history_transit_day","story_generation_form","parents_diversion_manifest","history_seventy_two_hours","story_family_principle","story_bridge_watched","story_generation_speech","history_three_day_silence"],"_driveLegsSinceBlock":0,"_roadEventDay":1,"_roadEventCount":0,"_lastRoadEventKm":-999,"_lastCampEventDay":-999,"memories":{"choices":{},"pending":[],"history":[]},"knowledge":{"current_exodus":2,"parents_work":2,"parent_principle":0,"parent_key":0,"repeated_expulsions":0,"family_order_source":0,"uplink_gap":0,"ai_identifies_caravan":0,"resistance_network":0},"relations":{"pairs":