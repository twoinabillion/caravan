{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":4,"min":510,"at":"lake","driving":null,"fuel":51.50746999999963,"fuelMax":70,"water":21,"waterMax":28,"food":16,"foodMax":24,"scrap":48,"van":97.74000000000011,"vanMax":100,"vanName":"달구지","items":{"부품":7,"의약품":1,"탄약":0},"party":["minji"],"comps":{"minji":{"mood":95,"bond":15,"lvl":2,"perks":["mj_camp","mj_eye"],"pending":0,"approach":"pulley","storyReady":true,"storyGateNotified":2},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","lake","sunflower"],"visited":["busan","yangsan","miryang","ulsan","lake"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"cell_sea":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"minji_request_heard":true,"bridge_departure_echo":true,"bridge_trace_gap":true,"minji_approach_drive":true,"bridge_watched":true,"rumor_sundeok":true,"rumor_byungchul":true,"rumor_yeongok":true,"sundeok_son":true,"trace_registry":true},"pursuit":0,"used":["cell_sea_meet","meet_postman","onboarding_first_road","ev_market_ruins","memory_busan_terminal","meet_scrapyard","rq_minji_request","story_bridge_departure_echo","story_bridge_trace_gap","rq_minji_task","lc_ulsan_whale","salvage_claim","camp_thief","rq_minji_join","talk_mj_14","story_bridge_watched","npc_sundeok_2","story_generation_form","loc_lake","talk_mj_02","ev_pc_cafe"],"quest":null,"recruitQ":null,"wx":"rain","wxNext":"clear","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"한 줄로 남기지 않는 항로","body":"해도의 배들은 출항 시각·포구·운반선을 나눠 감시 기록이 하나의 이동 경로로 이어지지 않게 한다.","links":["천리안","저항 연대망"],"day":1},{"id":"n11","type":"소문","title":"우편부의 지름길","body":"물 반 잔의 답례. 어느 고개의 지름길.","links":[],"day":1},{"id":"n12","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n16","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n17","type":"인물","title":"민지","body":"밀양 부품 천막의 정비사. 달구지 소리만 듣고 느슨한 클램프를 찾아냈다.\n떠나기 전의 일을 함께 끝낸 뒤 달구지에 합류했다. 임시 도르래를 만들었다. 범퍼와 휠 허브로 만든 도르래가 아직 적재칸 바닥을 굴러다닌다. 폐차장에서 혼자 살아남은 정비 천재. 오빠 민규를 찾아 북쪽으로 가려 한다.","links":["민지","밀양 장터"],"day":3},{"id":"n18","type":"인물","title":"민지와 울산까지","body":"오빠의 목소리가 남아 있을지도 모르는 진단기. 민지와 함께 꺼내러 가기로 했다.","links":["민지","울산 공단"],"day":1},{"id":"n19","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n20","type":"장소","title":"울산 공업탑","body":"DAY 2 도착. 멈춘 크레인들이 지평선을 이룬다. 세계에서 가장 조용한 공업도시.","links":[],"day":2},{"id":"n21","type":"사건","title":"무너지기 전의 목소리","body":"임시 도르래로 민규의 진단기를 구했다. 마지막 신호의 좌표를 확인할 길이 열렸다.","links":["민지","민규의 신호"],"day":2},{"id":"n22","type":"사건","title":"귀신고래 귀환","body":"사람이 조용해지자 고래가 돌아왔다. 멸망이 돌려준 것들의 목록.","links":[],"day":2},{"id":"n23","type":"인물","title":"민지 · 공구 없이 듣는 소리","body":"무슨 소린지만 궁금했다고 말한다. 고쳐 달라는 부탁 없이, 한동안 같이 달구지의 소리를 들었다.","links":["민지","달구지"],"day":2},{"id":"n24","type":"인물","title":"열넷의 정비소","body":"어른을 찾던 손님의 절반은 돌아갔고, 남은 절반의 차는 같은 고장으로 다시 오지 않았다.","links":["민지"],"day":3},{"id":"n25","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n26","type":"소문","title":"순덕의 소문","body":"북쪽 호수에 낚시꾼 영감이 혼자 사는데, 지나가는 사람한테 민물고기를 나눠준다더군. 밀양서 산길로 조금만 올라가면 돼.","links":["낚시꾼의 호수","순덕"],"day":3},{"id":"n27","type":"소문","title":"병철의 소문","body":"강 상류에서 정리자들이 뭘 건져 올리더라. 흰 옷 넷이서, 밤에, 등도 없이. 건진 게 뭔지는 안 보이더라만— 사람 크기였다. 상류 쪽에선 밤낚시 하지 마라.","links":["병철"],"day":3},{"id":"n28","type":"소문","title":"영옥의 소문","body":"창녕 쪽 폐도로 옆에 해바라기 밭이 살아 있다 카더라. 씨 받으러 가는 사람들이 있어. 기름도 짜고. 눈 호강은 덤이고. 가을 전에 가 봐라.","links":["해바라기 밭","영옥"],"day":3},{"id":"n29","type":"인물","title":"순덕의 막내","body":"수원 성곽의 화살수. 순덕의 부탁: 밥 잘 먹고 다니는지만 봐줄 것. 전언은 금지.","links":["순덕","수원"],"day":3},{"id":"n30","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":3},{"id":"n31","type":"장소","title":"낚시꾼의 호수","body":"DAY 3 도착. 댐 호수. 혼자 사는 낚시꾼이 물고기를 나눠준다는 소문.","links":[],"day":3},{"id":"n32","type":"사건","title":"호숫가 낚시","body":"낚시꾼과 오래 나란히 앉아 있었다. 낚싯대를 접으며 말린 생선 꾸러미를 받았다.","links":[],"day":3},{"id":"n33","type":"인물","title":"민지 · 고치지 않아도 되는 소리","body":"부품 1을 꺼내 함께 예비 퓨즈 자리를 만든다. 왼쪽 칸에 예비 퓨즈를 놓았다. 두 사람이 함께 꺼낼 수 있는 순서다.","links":["민지","달구지"],"day":3},{"id":"n34","type":"인물","title":"민지의 스쿠터","body":"브레이크 밀리던 고물 스쿠터. 죽기 싫어서 배운 정비가 직업이 됐다.","links":["민지"],"day":4}],"noteSeq":35,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":13,"met":true,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":5,"met":true,"chat":[]},"yeongok":{"att":5,"met":true,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":200.0000000000007,"events":21,"nonlethal":0},"routePlan":null,"thirst":0,"hunger":0,"ended":false,"seed":401099,"fatig