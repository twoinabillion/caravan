{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":4,"min":689.7,"at":null,"driving":{"from":"chungju","to":"cheongju","dist":40,"gone":26.454999999999984,"road":"normal","wx":"clear","slots":[{"at":25.653333333333336,"beat":true}],"si":1,"eventCount":2,"snapshot":{"gameMinute":6327.6,"fuel":17.469928333333343,"water":16,"food":9,"scrap":33,"van":73.8399999999985,"fatigue":12.378719999999994,"pursuit":1,"build":"기본 생존형"},"recruitEscort":"parkss"},"fuel":13.316493333333344,"fuelMax":70,"water":16,"waterMax":28,"food":9,"foodMax":24,"scrap":33,"van":73.8399999999985,"vanMax":100,"vanName":"달구지","items":{"부품":2,"의약품":1,"탄약":0,"남산행 편지":1},"party":[],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","airfield","lighthouse","tunnelbook"],"visited":["busan","gimhae","jinju","namwon","jeonju","muju","gimcheon","sangju","mungyeong","chungju"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"massacre_known":true,"jeonju_coldbag":true,"rumor_miyoung":true,"rumor_dongsu":true,"postman_letter":true,"rumor_jaepil":true,"rumor_jeomrye":true,"bridge_departure_echo":true,"parents_split_known":true,"bridge_trace_gap":true,"route_ridge_saved":true,"bridge_watched":true,"parents_routes_traced":true,"armed_age":true},"pursuit":1,"used":["meet_postman","onboarding_first_road","ev_truck_cafe","ev_broadcast_station","memory_busan_terminal","camp_thief","levy_office","meet_bus","salvage_claim","postman_again","story_bridge_departure_echo","route_mid_fork","parents_diversion_manifest","story_bridge_trace_gap","route_ridge_rescue","route_ridge_anchor","route_ridge_extract","story_bridge_watched","loc_mungyeong","camp_dogs","parents_separated_work","perimeter_first","cleaners_recall"],"quest":null,"recruitQ":{"id":"parkss","stage":"task","target":"gumi","startedDay":2,"metAt":"jeonju","sameStop":false,"escort":true},"wx":"clear","wxNext":"clear","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"고철 연결 고리로 유나가 탄 이송 버스의 난방을 살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"우편부의 지름길","body":"물 반 잔의 답례. 어느 고개의 지름길.","links":[],"day":1},{"id":"n11","type":"장소","title":"김해 들판","body":"DAY 1 도착. 민간 비행장이 있던 넓은 들판이다. 갈라진 활주로 위로 잡초가 길게 자라고, 북서쪽 유도로는 아직 바퀴가 지나갈 수 있다.","links":[],"day":1},{"id":"n12","type":"본편","title":"첫 번째 발신 기록","body":"이송 대상은 배급망이 바뀔 때마다 자동으로 다시 정해진다. 부모님의 이송표와 같은 곳에서 발신된 명령이다.","links":["부모님","천리안","남산"],"day":1},{"id":"n13","type":"장소","title":"진주 남강변","body":"DAY 1 도착. 강물은 그대로인데 다리는 반쪽이다. 유등 축제의 등롱 잔해가 강가에 쌓여 있다.","links":[],"day":1},{"id":"n14","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n15","type":"사건","title":"반복된 마지막 속보","body":"첫 정리 이후에도 서울 추방 방송은 여러 세대에 걸쳐 반복됐다.","links":[],"day":1},{"id":"n16","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n17","type":"장소","title":"남원 광한루","body":"DAY 1 도착. 무너진 누각 옆에서 누군가 판소리를 연습하고 있었다는 소문.","links":[],"day":1},{"id":"n18","type":"사건","title":"가짜 행정소","body":"관공서를 흉내 낸 통행세 사기. 꺼진 태블릿을 가리키자 물러섰다. 다음 차는 속을지도 모른다.","links":[],"day":2},{"id":"n19","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 181km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n20","type":"장소","title":"전주 서문 시장","body":"DAY 2 도착. 서쪽 최대 정착지. 음식 냄새가 나는 마지막 도시.","links":[],"day":2},{"id":"n21","type":"세대의 흔적","title":"문 앞에 놓인 국밥","body":"2026년 배달 가방이 세대를 지나 아픈 집에 국밥을 나르는 공동 가방으로 쓰였다.","links":["전주 서문 시장","2026년"],"day":2},{"id":"n22","type":"인물","title":"박 선생","body":"전주 서문의 진료 버스를 지키던 전직 약사. 구미 쪽 진료소로 따뜻해지기 전에 약을 옮겨야 한다.","links":["박 선생","전주 서문 시장"],"day":2},{"id":"n23","type":"소문","title":"미영의 소문","body":"논산 쪽 군 비행장, 격납고에 군수품이 남았다는 소문이 있어. 근데 아무도 안 가. 밤마다 활주로에 불이 들어온대. 착륙 유도등이. …누굴 기다리는 걸까?","links":["폐 군 비행장","미영"],"day":2},{"id":"n24","type":"소문","title":"동수의 소문","body":"서해 쪽 등대가 아직 돌아간답니다. 지키는 사람이 있다는 뜻이지요. 배도 없는 바다에 불을 켜는 이유를— 저는 알 것 같기도 합니다. 지도에 넣어 드리지요.","links":["서해 등대","동수"],"day":2},{"id":"n25","type":"소문","title":"남산행 편지","body":"우편부의 마지막에서 두 번째 편지. 수신인은 남산 아래 김OO. \"오래 걸렸다고는 말고.\"","links":["남산"],"day":2},{"id":"n26","type":"장소","title":"무주 터널","body":"DAY 2 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":2},{"id":"n27","type":"소문","title":"재필의 소문","body":"옆 터널에 책 미친 영감이 살아. 도서관을 통째로 옮겨놨지. 책 한 권 가져가면 얘기 하나를 들려준다더군. 세상이 왜 이렇게 됐는지에 대한 얘기도.","links":["책의 터널","재필"],"day":3},{"id":"n28","type":"소문","title":"점례의 소문","body":"첫서리 오기 전에 북쪽 고개를 넘어. 무주 눈은 한번 오면 길을 통째로 지워버려. 작년에 늦게 넘은 차가 봄에야 발견됐어. …차만.","links":["점례"],"day":3},{"id":"n29","type":"장소","title":"김천 갈림길","body":"DAY 3 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":3},{"id":"n30","type":"사건","title":"김천에서 고른 길: 동쪽 능선길","body":"약 130km · 빠르지만 험로가 많고, 구조할 사람을 외면하기 어렵다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":3},{"id":"n31","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":3},{"id":"n32","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 300km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n33","type":"장소","title":"상주 자전거길","body":"DAY 3 도착. 자전거의 도시. 기름 없는 세상에서 뒤늦게 전성기를 맞았다.","links":[],"day":3},{"id":"n34","type":"사건","title":"구조 기록: 비탈에 걸린 우편 수레","body":"지형: 젖은 절개지와 무너진 돌망\n처음 목표: 네 사람을 도로로 올린다\n실패 위험: 비탈이 다시 움직이기 전에 끝내야 한다\n멈춰 세우기 — 고정: 달구지를 바위 뒤에 걸고 견인줄을 내린다\n길 만들기 — 완력: 아래 남자를 업고 짧게 치고 오른다\n꺼내기 — 분리 인양: 사람과 수레에 줄을 다시 걸어 나눠 당긴다\n결과: 목표 달성. 차체 77/100, 관측 0/5.","links":["달구지","천리안"],"day":3},{"id":"n35","type":"사건","title":"능선 아래 네 사람","body":"달구지를 닻으로 삼아 네 사람과 문경행 해열제를 함께 올렸다.","links":["달구지"],"day":3},{"id":"n36","type":"장소","title":"문경새재","body":"DAY 3 도착. 과거 보러 넘던 옛 고개. 지금도 넘는 자에게 뭔가를 시험한다.","links":[],"day":3},{"id":"n37","type":"사건","title":"새재의 나무판","body":"\"지금 넘는 당신은 무엇을 보러 가는가.\" 한 단어를 적었다. 뜻은 적은 사람만 안다.","links":["할아버지"],"day":3},{"id":"n38","type":"사건","title":"두 곳에서 만든 한 절차","body":"아버지가 남산 유지선에 분리 절차를 나누어 숨겼음을 확인했다.","links":[],"day":4},{"id":"n39","type":"장소","title":"충주호","body":"DAY 4 도착. 거대한 호수는 그대로다. 물안개 너머로 낚싯배 하나가 느리게 지나간다.","links":[],"day":4},{"id":"n40","type":"사건","title":"첫 경고사격","body":"위수 구역의 경고탄에 튄 파편이 차 외판을 상하게 했다. 뒤 칸의 고철과 공구를 손 닿는 곳으로 옮겼다.","links":["천리안"],"day":4}],"noteSeq":41,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":0,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":9,"met":true,"chat":[]},"miyoung":{"att":17,"met":true,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":5,"met":true,"chat":[]},"dongsu":{"att":5,"met":true,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":392.45500000000277,"events":23,"nonlethal":1},"routePlan":{"id":"ridge","status":"active","chosenDay":3,"startedKm":276,"visited":["gimcheon","sangju","mungyeong","chungju"]},"thirst":0,"hunger":0,"ended":false,"seed":461079,"fatigue":20.889089999999985,"_dlv":3,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":4,"_lunchDay":3,"_storyQueue":[],"_recentEvents":["meet_bus","salvage_claim","postman_again","story_bridge_departure_echo","route_mid_fork","parents_diversion_manifest","story_bridge_trace_gap","route_ridge_rescue","route_ridge_anchor","route_ridge_extract","story_bridge_watched","loc_mungyeong","camp_dogs","parents_separated_work","perimeter_first","cleaners_recall"],"_recentEventTypes":["위기","스토리","위기","스토리","스토리","추적"],"_eventBreather":3,"_beatQueue":["history_transit_