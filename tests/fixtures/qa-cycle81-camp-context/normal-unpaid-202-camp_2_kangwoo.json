{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":4,"min":150.4,"at":"chungju","driving":null,"fuel":27.01846018666656,"fuelMax":70,"water":16,"waterMax":28,"food":9,"foodMax":24,"scrap":81,"van":78.33390190000088,"vanMax":100,"vanName":"달구지","items":{"부품":7,"의약품":1,"탄약":0},"party":["kangwoo"],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":76,"bond":9,"lvl":2,"perks":["kw_guard","kw_sniper"],"pending":0,"approach":"follow"},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","mall","reststop","drivein"],"visited":["busan","yangsan","miryang","daegu","gumi","gimcheon","sangju","mungyeong","chungju"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"bridge_departure_echo":true,"daegu_ticketbox":true,"rumor_taeho":true,"rumor_sera":true,"rumor_mansu":true,"cell_dome":true,"bridge_trace_gap":true,"kangwoo_approach_drive":true,"parents_split_known":true,"route_ridge_saved":true,"bridge_watched":true,"parents_routes_traced":true,"armed_age":true},"pursuit":1,"used":["lc_busan_dried","meet_postman","onboarding_first_road","ev_fire_station","memory_busan_terminal","story_bridge_departure_echo","kw_recruit","rq_kangwoo_task","cell_dome_meet","story_bridge_trace_gap","camp_thief","rq_kangwoo_join","talkr_kw_1","ev_broadcast_station","levy_office","route_mid_fork","parents_diversion_manifest","salvage_claim","route_ridge_rescue","route_ridge_anchor","route_ridge_extract","ev_gasstation_tank","story_bridge_watched","loc_mungyeong","parents_separated_work","crisis_drowsy","perimeter_first"],"quest":null,"recruitQ":null,"wx":"rain","wxNext":"rain","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"고철 연결 고리로 유나가 탄 이송 버스의 난방을 살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"우편부의 지름길","body":"물 반 잔의 답례. 어느 고개의 지름길.","links":[],"day":1},{"id":"n11","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n12","type":"본편","title":"첫 번째 발신 기록","body":"이송 대상은 배급망이 바뀔 때마다 자동으로 다시 정해진다. 부모님의 이송표와 같은 곳에서 발신된 명령이다.","links":["부모님","천리안","남산"],"day":1},{"id":"n13","type":"사건","title":"돌아오지 않은 대원들","body":"소방서 마지막 일지: 전 대원 출동, 시민 대피 유도 중. 그 뒤는 백지.","links":[],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n16","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n17","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n18","type":"장소","title":"대구 돔 시장","body":"DAY 1 도착. 야구장 지붕 아래 남부 최대의 시장이 산다.","links":[],"day":1},{"id":"n19","type":"사건","title":"다시 켜진 돔 전광판","body":"경기장이던 돔의 전광판은 지금 물자 도착과 미아 이름을 알린다. 끊어진 배선을 고쳐 한 구역을 되살렸다.","links":["대구 돔 시장"],"day":2},{"id":"n20","type":"세대의 흔적","title":"돔의 좌석 번호","body":"야구장 입장권의 좌석 번호가 시장에서 가족을 다시 찾는 번호표로 남았다.","links":["대구 돔 시장","2026년"],"day":2},{"id":"n21","type":"인물","title":"강우","body":"돔 시장을 홀로 지킨 파수꾼. 떠나고 싶어도 시장이 자신 없이 버티는 법부터 만들어야 한다.\n떠나기 전의 일을 함께 끝낸 뒤 달구지에 합류했다. 후임의 지시를 따랐다. 강우는 손전등 하나만 들고 서연의 순서대로 시장을 돌았다. 말이 없다. 자신이 겪은 서울 추방 때 수비대에 있었다. 서울 얘기가 나오면 창밖만 본다.","links":["강우"],"day":3},{"id":"n22","type":"사건","title":"경비탑의 다음 사람","body":"강우가 개입하지 않은 시간을 서연이 지켰다. 돔 시장에는 다음 파수꾼이 생겼다.","links":["강우"],"day":2},{"id":"n23","type":"소문","title":"태호의 소문","body":"구미 쪽 백화점 말이야, 다들 털렸다고 하는데 지하 창고는 아무도 못 열었대. 셔터가 내려져 있거든. 정비 도구가 있으면 얘기가 다르겠지만.","links":["유령 백화점","태호"],"day":2},{"id":"n24","type":"소문","title":"세라의 소문","body":"왜관 쪽 고속도로에 휴게소가 통째로 잠들어 있대요. 셔터 내린 그대로요. 호두과자 기계까지 그대로라던데— 믿거나 말거나. 지도에 표시해 드릴게요. 책 손님 특전.","links":["잠든 휴게소","세라"],"day":2},{"id":"n25","type":"소문","title":"만수의 소문","body":"구미 지나서 폐 자동차극장 하나 있다. 달 뜨면 스크린이 그렇게 하얗다 카더라. 나는 거기서 한 번 공연했지. 관객은 셋이었는데 박수는 삼십 명 몫을 치더라.","links":["달빛 자동차극장","만수"],"day":2},{"id":"n26","type":"인물","title":"돔 — 하 여사","body":"운송 장부는 여러 권으로 나뉘어 사람 손으로 이동한다. 대구는 천리안이 한눈에 읽을 수 없는 물류 거점이다.","links":["저항 연대망"],"day":2},{"id":"n27","type":"장소","title":"구미 공단 폐허","body":"DAY 2 도착. 멈춘 공장들. 굴뚝 하나에서 이유 모를 연기가 오른다.","links":[],"day":2},{"id":"n28","type":"인물","title":"강우 · 문손잡이에서 손을 떼기","body":"내일의 경계를 나눠 맡고 쉴 순번도 적는다. 접힌 지도에 경계와 휴식 순번을 함께 적었다. 강우가 쉬는 칸도 있다.","links":["강우","달구지"],"day":2},{"id":"n29","type":"사건","title":"가짜 행정소","body":"관공서를 흉내 낸 통행세 사기. 꺼진 태블릿을 가리키자 물러섰다. 다음 차는 속을지도 모른다.","links":[],"day":3},{"id":"n30","type":"장소","title":"김천 갈림길","body":"DAY 3 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":3},{"id":"n31","type":"사건","title":"김천에서 고른 길: 동쪽 능선길","body":"약 130km · 빠르지만 험로가 많고, 구조할 사람을 외면하기 어렵다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":3},{"id":"n32","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":3},{"id":"n33","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n34","type":"장소","title":"상주 자전거길","body":"DAY 3 도착. 자전거의 도시. 기름 없는 세상에서 뒤늦게 전성기를 맞았다.","links":[],"day":3},{"id":"n35","type":"사건","title":"구조 기록: 비탈에 걸린 우편 수레","body":"지형: 젖은 절개지와 무너진 돌망\n처음 목표: 네 사람을 도로로 올린다\n실패 위험: 비탈이 다시 움직이기 전에 끝내야 한다\n멈춰 세우기 — 고정: 달구지를 바위 뒤에 걸고 견인줄을 내린다\n길 만들기 — 완력: 아래 남자를 업고 짧게 치고 오른다\n꺼내기 — 분리 인양: 사람과 수레에 줄을 다시 걸어 나눠 당긴다\n결과: 목표 달성. 차체 88/100, 관측 0/5.","links":["달구지","천리안"],"day":3},{"id":"n36","type":"사건","title":"능선 아래 네 사람","body":"달구지를 닻으로 삼아 네 사람과 문경행 해열제를 함께 올렸다.","links":["달구지"],"day":3},{"id":"n37","type":"장소","title":"문경새재","body":"DAY 3 도착. 과거 보러 넘던 옛 고개. 지금도 넘는 자에게 뭔가를 시험한다.","links":[],"day":3},{"id":"n38","type":"사건","title":"새재의 나무판","body":"\"지금 넘는 당신은 무엇을 보러 가는가.\" 한 단어를 적었다. 뜻은 적은 사람만 안다.","links":["할아버지"],"day":3},{"id":"n39","type":"사건","title":"두 곳에서 만든 한 절차","body":"아버지가 남산 유지선에 분리 절차를 나누어 숨겼음을 확인했다.","links":[],"day":3},{"id":"n40","type":"장소","title":"충주호","body":"DAY 4 도착. 거대한 호수는 그대로다. 물안개 너머로 낚싯배 하나가 느리게 지나간다.","links":[],"day":4},{"id":"n41","type":"사건","title":"첫 경고사격","body":"위수 구역의 경고탄에 튄 파편이 차 외판을 상하게 했다. 뒤 칸의 고철과 공구를 손 닿는 곳으로 옮겼다.","links":["천리안"],"day":4}],"noteSeq":42,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":4,"met":false,"chat":[]},"taeho":{"att":17,"met":true,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":5,"met":true,"chat":[]},"mansu":{"att":5,"met":true,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":259.99999999999807,"events":27,"nonlethal":1},"routePlan":{"id":"ridge","status":"active","chosenDay":3,"startedKm":170,"visited":["gimcheon","sangju","mungyeong","chungju"]},"thirst":0,"hunger":0,"ended":false,"seed":801163,"fatigue":41.03529400000026,"_dlv":2,"_drowsyDay":0,"_drowsyAt":5783,"_breakfastDay":3,"_lunchDay":3,"_storyQueue":[],"_recentEvents":["rq_kangwoo_join","talkr_kw_1","ev_broadcast_station","levy_office","route_mid_fork","parents_diversion_manifest","salvage_claim","route_ridge_rescue","route_ridge_anchor","route_ridge_extract","ev_gasstation_tank","story_bridge_watched","loc_mungyeong","parents_separated_work","crisis_drowsy","perimeter_first"],"_recentEventTypes":["탐색","위기","스토리","스토리","위기","스토리"],"_eventBreather":3,"_beatQueue":["history_transit_day","story_generation_form","history_seventy_two_hours","story_family_principle","story_generation_speech",