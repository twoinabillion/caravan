{"v":8,"mode":"onroad","entryMode":"interactive","name":"하린","day":5,"min":1001.711,"at":"gimcheon","driving":null,"fuel":37.729018417665735,"fuelMax":70,"water":20,"waterMax":28,"food":18,"foodMax":24,"scrap":40,"van":83,"vanMax":100,"vanName":"달구지","items":{"부품":4,"의약품":1,"탄약":0},"party":["minji"],"comps":{"minji":{"mood":78,"bond":11,"lvl":0,"perks":[],"pending":1,"approach":"pulley"},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong"],"visited":["busan","yangsan","miryang","ulsan","daegu","gumi","gimcheon"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"onboarding_event_guide":true,"opening_call_answered":true,"main_mission_started":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"bridge_departure_echo":true,"food_poison":true,"bridge_trace_gap":true,"minji_approach_drive":true,"bridge_watched":true,"trace_registry":true,"levy_chased":true,"parents_split_known":true},"pursuit":0,"used":["lc_busan_dried","meet_postman","onboarding_first_road","exp_printshop","memory_busan_terminal","meet_scrapyard","exp_noodleworks","story_bridge_departure_echo","exp_mart","story_bridge_trace_gap","rq_minji_task","lc_ulsan_whale","salvage_claim","rq_minji_join","ev_rice_mill","story_bridge_watched","near_miryang_ice","story_generation_form","lc_daegu_makchang","levy_office","ev_broadcast_station","parents_diversion_manifest","route_mid_fork"],"quest":null,"recruitQ":null,"wx":"fog","wxNext":"fog","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다. 도윤의 표에는 이송 사유가 없었다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"부산에서 막힌 이의 제기","body":"도윤 가족의 이송표와 원격 이의 거절 응답을 함께 복사했다. 현장 확인 주소는 남산 중앙 노드였다.","links":["도윤의 가족","남산","천리안"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증 모듈","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"인물","title":"자전거 우편부","body":"주소 대신 이름과 얼굴로 배달한다. 여러 해째 수신인을 찾는 중.","links":[],"day":1},{"id":"n11","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n12","type":"본편","title":"첫 번째 발신 기록","body":"이송 대상은 배급망이 바뀔 때마다 자동으로 다시 정해진다. 부모님의 이송표와 같은 곳에서 발신된 명령이다.","links":["부모님","천리안","남산"],"day":1},{"id":"n13","type":"사건","title":"활판 한 장","body":"납활자로 찍은 \"서울까지 400km\". 세상에서 제일 느린 인쇄.","links":[],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부산 터미널에서 부모님의 다음 차를 오래 기다렸다.","links":[],"day":1},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n16","type":"인물","title":"민지","body":"밀양 장터에서 손을 다치지 않게 막아 준 정비사. 울산 폐차장의 진단기를 되찾아야 한다.\n떠나기 전의 일을 함께 끝낸 뒤 달구지에 합류했다. 임시 도르래를 만들었다. 범퍼와 휠 허브로 만든 도르래가 아직 적재칸 바닥을 굴러다닌다. 폐차장에서 혼자 살아남은 정비 천재. 오빠 민규를 찾아 북쪽으로 가려 한다.","links":["민지","민규의 신호","밀양 장터"],"day":3},{"id":"n17","type":"사건","title":"신종 국수","body":"제면소 수동 롤러로 뽑은 칼국수-우동 사이의 무언가. 당당한 후루룩.","links":[],"day":1},{"id":"n18","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n19","type":"장소","title":"울산 공업탑","body":"DAY 2 도착. 멈춘 크레인들이 지평선을 이룬다. 세계에서 가장 조용한 공업도시.","links":[],"day":2},{"id":"n20","type":"사건","title":"무너지기 전의 목소리","body":"임시 도르래로 민규의 진단기를 구했다. 마지막 신호의 좌표를 확인할 길이 열렸다.","links":["민지","민규의 신호"],"day":2},{"id":"n21","type":"인물","title":"민지 · 고치지 않아도 되는 소리","body":"고치는 대신 어떤 소리인지 함께 듣는다. 접시 한쪽은 비워 두었다. 급하지 않은 소리는 고치기 전에 함께 듣기로 했다.","links":["민지","달구지"],"day":2},{"id":"n22","type":"사건","title":"귀신고래 귀환","body":"사람이 조용해지자 고래가 돌아왔다. 멸망이 돌려준 것들의 목록.","links":[],"day":3},{"id":"n23","type":"인물","title":"민지 · 덮개를 열기 전에","body":"곁에 앉아 오늘 들은 소리를 비교한다. 자석 접시의 빈칸을 그대로 두었다. 점검이 끝나도 나란히 앉아 소리를 듣는다.","links":["민지","달구지"],"day":3},{"id":"n24","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":4},{"id":"n25","type":"장소","title":"밀양 얼음골","body":"산이 하는 냉장고. 한여름의 얼음. 소식벽 공유 예정.","links":[],"day":4},{"id":"n26","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":4},{"id":"n27","type":"장소","title":"대구 돔 시장","body":"DAY 4 도착. 야구장 지붕 아래 남부 최대의 시장이 산다.","links":[],"day":4},{"id":"n28","type":"장소","title":"구미 공단 폐허","body":"DAY 5 도착. 멈춘 공장들. 굴뚝 하나에서 이유 모를 연기가 오른다.","links":[],"day":5},{"id":"n29","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":5},{"id":"n30","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 300km. 핸들이 손에 붙는다.","links":[],"day":5},{"id":"n31","type":"장소","title":"김천 갈림길","body":"DAY 5 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":5}],"noteSeq":32,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":0,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":302.00000000000205,"events":23,"nonlethal":0},"routePlan":null,"thirst":0,"hunger":0,"ended":false,"seed":400911,"fatigue":42.01860535199989,"_dlv":3,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":5,"_lunchDay":5,"_storyQueue":[],"_recentEvents":["story_bridge_departure_echo","exp_mart","story_bridge_trace_gap","rq_minji_task","lc_ulsan_whale","salvage_claim","rq_minji_join","ev_rice_mill","story_bridge_watched","near_miryang_ice","story_generation_form","lc_daegu_makchang","levy_office","ev_broadcast_station","parents_diversion_manifest","route_mid_fork"],"_recentEventTypes":["스토리","조우","조우","탐색","스토리","스토리"],"_eventBreather":3,"_beatQueue":["history_transit_day","history_seventy_two_hours","story_family_principle","story_generation_speech","