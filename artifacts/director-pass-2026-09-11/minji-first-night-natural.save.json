{"v":7,"mode":"onroad","entryMode":"interactive","name":"하린","day":3,"min":1139.219,"at":"gyeongju","driving":null,"fuel":28.510398499999155,"fuelMax":70,"water":16,"waterMax":28,"food":24,"foodMax":24,"scrap":45,"van":83,"vanMax":100,"vanName":"달구지","items":{"부품":5,"의약품":1,"탄약":0},"party":[],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","lake"],"visited":["busan","yangsan","miryang","ulsan","gyeongju"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"onboarding_event_guide":true,"opening_call_answered":true,"main_mission_started":true,"cell_sea":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"bridge_departure_echo":true,"bridge_trace_gap":true},"pursuit":0,"used":["cell_sea_meet","meet_postman","onboarding_first_road","exp_mart","memory_busan_terminal","meet_scrapyard","exp_icehouse","story_bridge_departure_echo","story_bridge_trace_gap","rq_minji_task","lc_ulsan_whale","camp_visitor","ev_rice_mill","salvage_claim","loc_gyeongju"],"quest":null,"recruitQ":{"id":"minji","stage":"follow","target":"gyeongju","startedDay":1,"metAt":"miryang","sameStop":false,"escort":true,"choice":"pulley","choiceDay":2,"roadFrom":"ulsan","roadDay":2,"followDay":3},"wx":"fog","wxNext":"clear","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"물건","title":"엄마의 철제 상자","body":"수첩 등판에서 현재 이송표와 같은 규격의 회로도가 나왔다. 남산 중앙 노드, 달구지 계기판 뒤 검증 모듈, 발신 기록과 당사자 증언을 함께 가져가라는 메모가 적혀 있었다.","links":["부모님","천리안","달구지"],"day":1},{"id":"n6","type":"물건","title":"계기판 속 검증 모듈","body":"출발 전에 존재를 확인했지만 분리 절차 두 장이 없어 아직 달구지 전장에 연결해 두었다. 절차를 찾고 기록을 모아 남산에 적용해야 한다.\n엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","남산","달구지"],"day":1},{"id":"n7","type":"인물","title":"도윤의 가족","body":"부산 부두에서 난방이 끊긴 이송 버스를 고쳐 준 가족. 엄마 하진, 8살 도윤, 동생 유나는 제7 잔류구역 6,412명 가운데 먼저 남쪽으로 보내진 사람들이다.","links":["서울 추방","천리안"],"day":1},{"id":"n8","type":"본편","title":"남산 코어로 가서 강제 이송 명령을 멈춘다","body":"부산에서는 이 명령에 이의를 제기할 수 없었다. 북쪽으로 가며 발신 기록과 분리 절차, 당사자 증언을 모은 뒤 남산 중앙 노드에서 명령을 멈춰야 한다. 날짜 제한은 없고, 서울에 도착하는 것만으로는 끝나지 않는다.","links":["남산","도윤의 가족","계기판 속 검증 모듈"],"day":1},{"id":"n9","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n10","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다. 도윤의 표에는 이송 사유가 없었다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n11","type":"출발","title":"부산에서 막힌 이의 제기","body":"도윤 가족의 이송표와 원격 이의 거절 응답을 함께 복사했다. 현장 확인 주소는 남산 중앙 노드였다.","links":["도윤의 가족","남산","천리안"],"day":1},{"id":"n12","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n13","type":"인물","title":"해도 — 김 선장","body":"항구 밖 중계 공백과 포구별 분산 운송을 이용하는 바닷길 연대. 북쪽에서 육로가 막힐 때 쓸 접선 표식을 받았다.","links":["저항 연대망"],"day":1},{"id":"n14","type":"인물","title":"자전거 우편부","body":"주소 대신 이름과 얼굴로 배달한다. 여러 해째 수신인을 찾는 중.","links":[],"day":1},{"id":"n15","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n16","type":"본편","title":"첫 번째 발신 기록","body":"이송 대상은 배급망이 바뀔 때마다 자동으로 다시 정해진다. 부모님의 이송표와 같은 곳에서 발신된 명령이다.","links":["부모님","천리안","남산"],"day":1},{"id":"n17","type":"사건","title":"부산 터미널의 마지막 불","body":"부산 터미널에서 부모님의 다음 차를 오래 기다렸다.","links":[],"day":1},{"id":"n18","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n19","type":"인물","title":"민지","body":"밀양 장터에서 손을 다치지 않게 막아 준 정비사. 울산 폐차장의 진단기를 되찾아야 한다.","links":["민지","민규의 신호","밀양 장터"],"day":1},{"id":"n20","type":"사건","title":"식은 창고의 약속","body":"\"필요한 만큼만. 다음 사람 몫도.\" 제빙 공장 단열창고의 공용 저장고.","links":[],"day":1},{"id":"n21","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n22","type":"장소","title":"울산 공업탑","body":"DAY 2 도착. 멈춘 크레인들이 지평선을 이룬다. 세계에서 가장 조용한 공업도시.","links":[],"day":2},{"id":"n23","type":"사건","title":"무너지기 전의 목소리","body":"임시 도르래로 민규의 진단기를 구했다. 마지막 신호의 좌표를 확인할 길이 열렸다.","links":["민지","민규의 신호"],"day":2},{"id":"n24","type":"사건","title":"귀신고래 귀환","body":"사람이 조용해지자 고래가 돌아왔다. 멸망이 돌려준 것들의 목록.","links":[],"day":2},{"id":"n25","type":"인물","title":"걷는 노인","body":"오랫동안 걸어서 전국을 도는 사람. \"걸으면 다 보여.\"","links":[],"day":3},{"id":"n26","type":"장소","title":"경주 왕릉","body":"DAY 3 도착. 왕릉 사이에 텐트 몇 동. 천년을 버틴 언덕들은 멸망도 대수롭지 않아 한다.","links":[],"day":3},{"id":"n27","type":"사건","title":"왕릉 소풍","body":"경주 왕릉 아래서 마을 아이와 옥수수를 먹고 쉬었다.","links":[],"day":3}],"noteSeq":28,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":0,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":154.00000000000023,"events":15,"nonlethal":0},"routePlan":null,"thirst":0,"hunger":0,"ended":false,"seed":400911,"fatigue":30.429306915999923,"_dlv":1,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":3,"_lunchDay":3,"_storyQueue":[],"_recentEvents":["cell_sea_meet","meet_postman","onboarding_first_road","exp_mart","memory_busan_terminal","meet_scrapyard","exp_icehouse","story_bridge_departure_echo","story_bridge_trace_gap","rq_minji_task","lc_ulsan_whale","camp_visitor","ev_rice_mill","salvage_claim","loc_gyeongju"],"_recentEventTypes":["스토리","조우","조우","탐색","조우","탐색"],"_eventBreather":3,"_beatQueue":["history_transit_day","story_generation_form","parents_diversion_manifest","history_seventy_two_hours","story_family_principle","story_bridge_watched","story_generation_speech","history_three_day_silence"],"_driveLegsSinceBlock":0,"_roadEventDay":3,"_roadEventCount":1,"_lastRoadEventKm":120.00000000000021,"_lastCampEventDay":3,"memories":{"choices":{},"pending":[],"history":[]},"knowledge":{"current_exodus":2,"parents_work":2,"parent_principle":0,"parent_key":0,"repeated_expulsions":0,"family_order_source":0,"uplink_gap":0,"ai_identifies_caravan":0,"resistance_network":0},"relation