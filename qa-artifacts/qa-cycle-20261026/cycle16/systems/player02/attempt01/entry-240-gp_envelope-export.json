true,"postman_met":true,"bridge_departure_echo":true,"rumor_geumja":true,"rumor_suwan":true,"bridge_trace_gap":true,"bridge_watched":true,"massacre_known":true,"levy_chased":true,"cell_mountain":true,"trace_registry":true,"rumor_jaepil":true,"rumor_jeomrye":true,"jaepil_candles":true,"parents_split_known":true,"leo_approach_drive":true,"parents_routes_traced":true,"parent_principle_found":true,"rumor_miyoung":true,"rumor_dongsu":true},"pursuit":0,"used":["cell_sea_meet","lc_busan_dried","ev_truck_cafe","onboarding_first_road","exp_towyard","meet_postman","camp_dogs","exp_reservoir","memory_busan_terminal","ev_salt_farmer","crisis_nofuel","exp_icehouse","salvage_claim","loc_suncheon","story_bridge_departure_echo","meet_hitchhiker","lc_damyang_juktong","story_bridge_trace_gap","story_bridge_watched","rq_leo_task","postman_again","ev_broadcast_station","levy_office","cell_mountain_meet","story_generation_form","npc_jaepil_2","parents_diversion_manifest","rq_leo_join","near_geochang_actor","parents_separated_work","exp_gas","story_family_principle","meet_bus","lc_jeonju_bibim","gp_envelope"],"quest":null,"recruitQ":{"id":"parkss","stage":"task","target":"gumi","startedDay":7,"metAt":"jeonju","sameStop":false,"escort":true},"wx":"clear","wxNext":"clear","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"검증키를 억지로 떼지 않고 현재 배선 경로를 회로도에 남겼다. 빠진 분리 절차 두 장을 찾아야 한다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"목에 건 작업장 열쇠","body":"감천 작업장 열쇠를 지닌 채 북쪽으로 출발했다. 돌아올 약속은 날짜 대신 열쇠로 남겼다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"한 줄로 남기지 않는 항로","body":"해도의 배들은 출항 시각·포구·운반선을 나눠 감시 기록이 하나의 이동 경로로 이어지지 않게 한다.","links":["천리안","저항 연대망"],"day":1},{"id":"n11","type":"소문","title":"옥상 커피나무","body":"북쪽 어느 옥상에서 커피를 재배하는 사람이 있다. 트럭 카페 주인 제보.","links":[],"day":1},{"id":"n12","type":"장소","title":"김해 들판","body":"DAY 1 도착. 민간 비행장이 있던 넓은 들판이다. 갈라진 활주로 위로 잡초가 길게 자라고, 북서쪽 유도로는 아직 바퀴가 지나갈 수 있다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"여기 견인 불가. 사람만.","body":"그날 어느 기사의 선택이 남긴 별표. 좋은 자리로 분류.","links":[],"day":1},{"id":"n15","type":"소문","title":"우편부의 지름길","body":"물 반 잔의 답례. 어느 고개의 지름길.","links":[],"day":1},{"id":"n16","type":"장소","title":"진주 남강변","body":"DAY 1 도착. 강물은 그대로인데 다리는 반쪽이다. 유등 축제의 등롱 잔해가 강가에 쌓여 있다.","links":[],"day":1},{"id":"n17","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n18","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":2},{"id":"n19","type":"장소","title":"여수 밤바다","body":"DAY 2 도착. 등불 몇 개가 아직 바다에 뜬다. 노래 가사가 현실이 된 도시.","links":[],"day":2},{"id":"n20","type":"사건","title":"식은 창고의 약속","body":"\"필요한 만큼만. 다음 사람 몫도.\" 제빙 공장 단열창고의 공용 저장고.","links":[],"day":3},{"id":"n21","type":"장소","title":"순천만 갈대밭","body":"DAY 3 도착. 갈대가 바람의 모양을 그대로 보여준다. 철새들은 여전히 온다.","links":[],"day":3},{"id":"n22","type":"사건","title":"순천만의 약속","body":"철새 떼가 물 위에 내려앉아 있다. 세상이 어떻게 되든 약속은 지키는 쪽이 있다.","links":[],"day":3},{"id":"n23","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n24","type":"장소","title":"광주 대인시장","body":"DAY 3 도착. 호남 최대의 정착지. 시장 골목엔 아직 기름 냄새와 정이 흐른다.","links":[],"day":3},{"id":"n25","type":"사건","title":"대인시장의 발전기 줄","body":"세 발전기가 벨트 하나를 나눠 쓰는 시장의 교대 순서를 돕고 예비 풀리 하나를 받았다.","links":["광주 대인시장","달구지"],"day":4},{"id":"n26","type":"인물","title":"레오와 보리","body":"광주 대인시장에서 만난 떠돌이 가수와 개. 남원 쪽 침수 지하차도의 목소리를 확인하려 한다.","links":["레오","광주 대인시장"],"day":4},{"id":"n27","type":"소문","title":"의뢰: 약 꾸러미","body":"광주 대인시장에서 맡은 배달 의뢰. 무주 터널까지. 사례는 고철 17. 기한 8일차.","links":["무주 터널"],"day":4},{"id":"n28","type":"소문","title":"금자의 소문","body":"섬진강 쪽에 매화마을 있는 거 아는가? 봄이면 강가가 하얗게 뒤집어져. 매실청 담그는 할매들이 아직 살어. 순천서 강길로 쬐끔만 가면 돼야.","links":["섬진강 매화마을","금자"],"day":4},{"id":"n29","type":"소문","title":"수완의 소문","body":"화순 쪽 능선에 송전탑 겸 통신탑이 서 있어. 거기 올라가면 안 잡히던 주파수가 잡혀. 나는 무릎이 이래서 못 가. 가면 테이프 하나만 감아다 줘.","links":["송전 통신탑","수완"],"day":4},{"id":"n30","type":"사건","title":"서로 돕는 밥","body":"대나무가 밥을 지키고 밥이 향을 얻는다. 버릴 게 없는 한 끼.","links":[],"day":4},{"id":"n31","type":"장소","title":"담양 대숲","body":"DAY 4 도착. 대나무 숲이 바람마다 파도 소리를 낸다. 바다에서 멀수록 크게.","links":[],"day":4},{"id":"n32","type":"장소","title":"남원 광한루","body":"DAY 4 도착. 무너진 누각 옆에서 누군가 판소리를 연습하고 있었다는 소문.","links":[],"day":4},{"id":"n33","type":"사건","title":"보리를 데리러 돌아간 길","body":"같이 물에 들어가 보리를 구했다. 끊긴 노래는 엉망인 합창으로 이어졌다.","links":["레오","보리"],"day":5},{"id":"n34","type":"인물","title":"끝까지 가는 우편부","body":"배달은 끝까지가 원칙. 자전거로 남산까지. 정말 갈 사람.","links":[],"day":5},{"id":"n35","type":"사건","title":"반복된 마지막 속보","body":"첫 정리 이후에도 서울 추방 방송은 여러 세대에 걸쳐 반복됐다.","links":[],"day":5},{"id":"n36","type":"장소","title":"거창 분지","body":"DAY 5 도착. 산으로 둘러싸인 분지. 안개가 자주 고인다.","links":[],"day":5},{"id":"n37","type":"인물","title":"산지기 — 감시 거부","body":"전파와 총소리를 피하며 능선에서 사는 사람들. 남산도 도로 대신 산으로 붙을 수 있다고 했다.","links":["저항 연대망","남산"],"day":5},{"id":"n38","type":"인물","title":"빈칸을 물려받은 집","body":"노인의 증조모·할머니·어머니의 이송표. 사유는 없지만 노인은 세 사람의 삶을 기억했다.","links":["서울 추방"],"day":5},{"id":"n39","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 301km. 핸들이 손에 붙는다.","links":[],"day":5},{"id":"n40","type":"장소","title":"무주 터널","body":"DAY 5 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":5},{"id":"n41","type":"사건","title":"배달 완료: 약 꾸러미","body":"광주 대인시장 → 무주 터널. 사례 고철 21. 받은 이의 얼굴이 밝아졌다.","links":[],"day":6},{"id":"n42","type":"소문","title":"재필의 소문","body":"옆 터널에 책 미친 영감이 살아. 도서관을 통째로 옮겨놨지. 책 한 권 가져가면 얘기 하나를 들려준다더군. 세상이 왜 이렇게 됐는지에 대한 얘기도.","links":["책의 터널","재필"],"day":6},{"id":"n43","type":"소문","title":"점례의 소문","body":"첫서리 오기 전에 북쪽 고개를 넘어. 무주 눈은 한번 오면 길을 통째로 지워버려. 작년에 늦게 넘은 차가 봄에야 발견됐어. …차만.","links":["점례"],"day":6},{"id":"n44","type":"인물","title":"재필의 116개 촛불","body":"식구 92 + 떠난 사람 24. 나간 사람의 촛불은 끄지 않는다. 터널은 등대였다.","links":["재필"],"day":6},{"id":"n45","type":"사건","title":"오지 않은 다음 차","body":"부모님이 아이의 보호 경로를 지키기 위해 이송에 응했음을 확인했다.","links":[],"day":6},{"id":"n46","type":"인물","title":"레오","body":"떠나기 전의 일을 함께 끝낸 뒤 달구지에 합류했다. 함께 물에 들어갔다. 말도 안 맞던 합창 한 소절을 레오가 자꾸 웃으며 흥얼거린다. 기타 하나, 개 한 마리. 세상이 끝났는데도 신곡을 쓴다. 개 이름은 보리.","links":[],"day":6},{"id":"n47","type":"사건","title":"두 곳에서 만든 한 절차","body":"어머니가 생활 물자 속에 증언을 숨겨 북쪽으로 보냈음을 확인했다.","links":[],"day":6},{"id":"n48","type":"사건","title":"인과의 점으로 분류된 사람들","body":"천리안은 사람을 미래 결과의 고위험·고효율 노드로 분류했다. 엄마는 그 계산이 권리를 대신할 수 없다고 남겼다.","links":["천리안","부모님의 검증키"],"day":7},{"id":"n49","type":"사건","title":"운전 숙련: 로드마스터","body":"누적 주행 441km. 로드마스터 — 할아버지가 스스로를 그렇게 불렀다. 이제 그 이름이 내 것이 됐다.","links":["할아버지"],"day":7},{"id":"n50","type":"장소","title":"전주 서문 시장","body":"DAY 7 도착. 서쪽 최대 정착지. 음식 냄새가 나는 마지막 도시.","links":[],"day":7},{"id":"n51","type":"인물","title":"박 선생","body":"전주 서문의 진료 버스를 지키던 전직 약사. 구미 쪽 진료소로 식기 전 약을 옮겨야 한다.","links":["박 선생","전주 서문 시장"],"day":7},{"id":"n52","type":"소문","title":"미영의 소문","body":"논산 쪽 군 비행장, 격납고에 군수품이 남았다는 소문이 있어. 근데 아무도 안 가. 밤마다 활주로에 불이 들어온대. 착륙 유도등이. …누굴 기다리는 걸까?","links":["폐 군 비행장","미영"],"day":7},{"id":"n53","type":"소문","title":"동수의 소문","body":"서해 쪽 등대가 아직 돌아간답니다. 지키는 사람이 있다는 뜻이지요. 배도 없는 바다에 불을 켜는 이유를— 저는 알 것 같기도 합니다. 지도에 넣어 드리지요.","links":["서해 등대","동수"],"day":7}],"noteSeq":54,"npcs":{"geumja":{"att":9,"met":true,"chat":[]},"sundeok":{"att":0,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":11,"met":true,"chat":[]},"miyoung":{"att":5,"met":true,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":5,"met":true,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":11,"met":true,"chat":[]},"dongsu":{"att":5,"met":true,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":475.868333333336,"events":35,"nonlethal":0},"routePlan":null,"thirst":0,"hunger":0,"ended":false,"seed":276002,"fatigue":43.807719999999925,"_dlv":4,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":7,"_lunchDay":7,"_storyQueue":[],"_recentEvents":["rq_leo_task","postman_again","ev_broadcast_station","levy_office","cell_mountain_meet","story_generation_form","npc_jaepil_2","parents_diversion_manifest","rq_leo_join","near_geochang_actor","parents_separated_work","exp_gas","story_family_principle","meet_bus","lc_jeonju_bibim","gp_envelope"],"_recentEventTypes":["스토리","탐색","스토리","조우","조우","동행"],"_eventBreather":3,"_beatQueue":["history_transit_day","history_seventy_two_hours","story_generation_speech","history_three_day_silence","history_first_recorders","story_generation_theories","history_six_roads","story_generation_ro