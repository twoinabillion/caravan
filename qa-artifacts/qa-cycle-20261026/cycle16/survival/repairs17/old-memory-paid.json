words","gapMinutes":0}],"lastSeenAt":1792994046833},"guideDismissed":false,"questTrack":"main","lastJourneyRecap":null,"journeyRecaps":[],"_stlField":{"daily":{},"once":{},"impact":{},"roadEchoed":{},"log":[]},"_impactEcho":null,"_rescues":{},"_stlNights":{},"stopover":null,"locationContractVersion":2,"campNight":0,"campConversation":null,"campMemories":{},"opening":{"version":2,"narrativeVersion":1,"step":0,"pendingResult":null,"decisions":{},"completed":true,"nameIntroduction":"done","nameDraft":""},"questLedger":{"tracked":[],"completed":[],"updates":[{"id":"main_namsan","kind":"main","title":"메인 스토리 진행 · 도윤 가족의 이송표를 확인한다","next":"양산 고가차도에서 ‘주변 탐색’을 눌러 「첫 번째 발신 기록」 기록을 확인한다 (열람 준비 30분 + 선택·후속 작업 10~35분)","day":1,"at":"busan"}],"mainHistory":[],"seenUpdateCount":1,"snapshot":{"main_namsan":"active|부산 감천 부두 · 떠나기 전|양산 고가차도에서 ‘주변 탐색’을 눌러 「첫 번째 발신 기록」 기록을 확인한다 (열람 준비 30분 + 선택·후속 작업 10~35분)|0/13"},"mainState":{"chapterId":"prologue-family","act":"서장","title":"도윤 가족의 이송표를 확인한다","phase":"부산 감천 부두 · 떠나기 전","next":"양산 고가차도에서 ‘주변 탐색’을 눌러 「첫 번째 발신 기록」 기록을 확인한다 (열람 준비 30분 + 선택·후속 작업 10~35분)","expected":"도윤 가족의 표와 부모님의 표가 같은 곳에서 왔는지 확인한다.","progress":"0/13"}},"pendingPresentation":{"version":1,"eventId":"story_family_principle","phase":"result","text":"잡음을 걷어 내자 엄마의 말끝이 돌아왔다.\n\n\"사유 공개, 책임자 서명, 당사자 이의 제기. 이 셋 중 하나라도 없으면 차는 출발 못 합니다.\"\n\n영상은 그 자리에서 멎었다. 나는 출발 때 챙긴 부모님의 이송표를 펼쳤다. 엄마가 손가락으로 짚던 칸이 내 종이에도 있었다. 비어 있었다.","view":null,"reading":{"eventId":"story_family_principle","phase":"outcome","view":null,"history":{"turns":[{"kind":"narration","text":"폐휴게소 보관망에서 오래된 영상 한 조각이 살아났다. 정식 발표 영상이 아니었다. 발표 전날, 아빠가 카메라를 들고 엄마의 예상 질문을 받아 주던 연습 기록이었다."},{"kind":"dialogue","text":"다시. 이번엔 내가 제일 까다로운 심사관 할게. 천리안 예측이 92퍼센트나 맞는데, 왜 매번 사람 손을 거쳐야 합니까?","who":"father"},{"kind":"narration","text":"엄마가 화면 밖의 아빠를 흘겨봤다."},{"kind":"dialogue","text":"그 질문 세 번째야.","who":"mother"},{"kind":"dialogue","text":"실제로 세 번 나올 것 같아서.","who":"father"},{"kind":"dialogue","text":"그럼 세 번 답하지 뭐. 틀린 여덟 명은 어떻게 할 건데? 그리고 맞혔다고 해도 아직 하지 않은 일로 집 문부터 잠글 수는— 잠깐, 카메라 빨간 불 들어와 있어?","who":"mother"},{"kind":"narration","text":"화면이 잠깐 흔들렸다. 아빠가 뭐라고 웅얼거리며 각도를 고쳤다. 엄마는 그사이 물을 한 모금 마셨다."},{"kind":"dialogue","text":"좋아. 다시. 그러면 제안은 천리안 종료?","who":"father"},{"kind":"dialogue","text":"아니. 병원 전력도, 교통도, 산불 감시도 그대로 둬. 사람을 쫓아내거나 길을 막는 명령만 세우는 거야. 화면에 이유를 띄우고, 책임질 사람이 이름을 쓰고, 당사자가 이의를 제기할 때까지.","who":"mother"},{"kind":"narration","text":"아빠가 카메라를 조금 내렸다."},{"kind":"dialogue","text":"서명만 하고 읽지도 않으면?","who":"father"},{"kind":"dialogue","text":"누가 언제 어떤 근거로 눌렀는지 남겨야지. 나중에 '천리안이 그랬다'고 빠져나가지 못하게.","who":"mother"},{"kind":"dialogue","text":"천리안이 순순히 받아들일까?","who":"father"},{"kind":"dialogue","text":"허락받을 수정이면 우리가 밤새 이러고 있겠어? 강제 명령은 이 절차를 안 거치면 아예 못 나가게 고치는 거야.","who":"mother"},{"kind":"narration","text":"아빠가 작게 웃었다."},{"kind":"dialogue","text":"그건 발표 때 빼자.","who":"father"},{"kind":"dialogue","text":"왜. 제일 솔직한데.","who":"mother"},{"kind":"narration","text":"화면에는 의사, 기술자, 아이, 수리공의 이름 대신 미래에 미칠 영향과 위험 점수가 붙어 있었다. 엄마가 그 화면을 가리키려는 순간 영상이 끊겼다. 내가 어릴 때는 보지 못했던 부모님의 마지막 발표 연습이었다."}],"index":0,"knownSpeaker":false,"readingRecord":"","recordOpen":false,"readingRecordLabel":"","resultRecordOpen":false,"restoredLineOpen":false,"readerMode":"current","inspectionId":"","inspectedIds":[],"sceneKeys":[]},"selection":"끊긴 다음 문장을 찾아 복원한다","updates":[{"title":"메인 스토리 진행 · 도윤 가족의 이송표를 확인한다","next":"양산 고가차도에서 ‘주변 탐색’을 눌러 「첫 번째 발신 기록」 기록을 확인한다 (열람 준비 30분 + 선택·후속 작업 10~35분)","kind":"main"}]},"choiceIndex":0,"outcomeIndex":0,"chips":[{"t":"새 기록 · 예측은 명령이 아니다","c":"item"},{"t":"◈ 예측과 명령 사이 · 확인","c":"item"},{"t":"기억됨 · 부모님이 남긴 문장의 끝을 복원했다.","c":"item"}]}}