{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":4,"min":1010.3,"at":"jeonju","driving":null,"fuel":55.95442693333287,"fuelMax":70,"water":19,"waterMax":28,"food":12,"foodMax":24,"scrap":48,"van":90.41999999999977,"vanMax":100,"vanName":"달구지","items":{"부품":6,"의약품":1,"탄약":0,"할아버지의 봉투":1},"party":["kangwoo"],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":79,"bond":14,"lvl":3,"perks":["kw_guard","kw_sniper","kw_story"],"pending":0,"approach":"rebuild"},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong"],"visited":["busan","yangsan","miryang","daegu","gumi","gimcheon","muju","jeonju"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"cell_sea":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"miryang_oldcard":true,"bridge_departure_echo":true,"cell_dome":true,"bridge_trace_gap":true,"massacre_known":true,"kangwoo_approach_drive":true,"parents_split_known":true,"route_market_failed":true,"kw_truth":true,"bridge_watched":true,"gp_envelope_found":true},"pursuit":2,"used":["cell_sea_meet","meet_postman","onboarding_first_road","exp_ricemill","memory_busan_terminal","story_bridge_departure_echo","kw_recruit","rq_kangwoo_task","cell_dome_meet","story_bridge_trace_gap","rq_kangwoo_join","talk_kw_02","ev_broadcast_station","levy_office","route_mid_fork","parents_diversion_manifest","salvage_claim","route_market_convoy","route_market_mask","route_market_pass","talk_kw_19","story_bridge_watched","gp_envelope","meet_bus"],"quest":null,"recruitQ":{"id":"parkss","stage":"task","target":"gumi","startedDay":4,"metAt":"jeonju","sameStop":false,"escort":true},"wx":"clear","wxNext":"storm","up":{"bench":true},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"물자를 쓰지 않고 호스를 우회해 유나가 탄 버스의 난방을 살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"인물","title":"해도 — 김 선장","body":"항구 밖 중계 공백과 포구별 분산 운송을 이용하는 바닷길 연대. 북쪽에서 육로가 막힐 때 쓸 접선 표식을 받았다.","links":["저항 연대망"],"day":1},{"id":"n11","type":"인물","title":"자전거 우편부","body":"주소 대신 이름과 얼굴로 배달한다. 여러 해째 수신인을 찾는 중.","links":[],"day":1},{"id":"n12","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부산 터미널에서 부모님의 다음 차를 오래 기다렸다.","links":[],"day":1},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n16","type":"사건","title":"달구지 개조: 후미 레일 좌석칸","body":"차대 레일과 바닥을 40cm 늘리고 안전벨트 좌석을 고정한다 — 달구지가 조금 더 우리 집이 됐다.","links":[],"day":1},{"id":"n17","type":"인물","title":"영옥","body":"장터 닭죽집. 밀양 장터의 사람.","links":["밀양 장터"],"day":2},{"id":"n18","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":2},{"id":"n19","type":"세대의 흔적","title":"2026년 교통카드 번호표","body":"대중교통을 타던 카드는 143년 뒤 밀양 장터의 국수 대기 번호표가 되었다. 기능은 잊혔지만 차례를 지키는 용도만은 남았다.","links":["밀양 장터","2026년"],"day":2},{"id":"n20","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n21","type":"장소","title":"대구 돔 시장","body":"DAY 2 도착. 야구장 지붕 아래 남부 최대의 시장이 산다.","links":[],"day":2},{"id":"n22","type":"인물","title":"강우","body":"돔 시장을 홀로 지킨 파수꾼. 떠나고 싶어도 시장이 자신 없이 버티는 법부터 만들어야 한다.\n떠나기 전의 일을 함께 끝낸 뒤 달구지에 합류했다. 경계선을 새로 짰다. 강우의 옛 지도 위에 서연이 고친 더 짧은 순찰선이 겹쳐 있다. 말이 없다. 자신이 겪은 서울 추방 때 수비대에 있었다. 서울 얘기가 나오면 창밖만 본다.","links":["강우"],"day":3},{"id":"n23","type":"사건","title":"경비탑의 다음 사람","body":"감시 표식을 뜯고 서연이 직접 고친 새 경계선을 세웠다.","links":["강우"],"day":2},{"id":"n24","type":"인물","title":"강우 · 문손잡이에서 손을 떼기","body":"서연에게 가르친 것을 묻고 먼저 호출하지 않는다. 접힌 경계 지도에 수신 채널을 적었다. 먼저 지시하기보다 호출을 기다리는 자리다.","links":["강우","달구지"],"day":2},{"id":"n25","type":"인물","title":"만수","body":"떠돌이 뽕짝 장사꾼. 대구 돔 시장의 사람.","links":["대구 돔 시장"],"day":3},{"id":"n26","type":"인물","title":"돔 — 하 여사","body":"운송 장부는 여러 권으로 나뉘어 사람 손으로 이동한다. 대구는 천리안이 한눈에 읽을 수 없는 물류 거점이다.","links":["저항 연대망"],"day":3},{"id":"n27","type":"장소","title":"구미 공단 폐허","body":"DAY 3 도착. 멈춘 공장들. 굴뚝 하나에서 이유 모를 연기가 오른다.","links":[],"day":3},{"id":"n28","type":"인물","title":"300원의 소원","body":"강우의 소원 1호: 부대 앞 자판기 커피(설탕 프림 전부).","links":["강우"],"day":3},{"id":"n29","type":"사건","title":"반복된 마지막 속보","body":"첫 정리 이후에도 서울 추방 방송은 여러 세대에 걸쳐 반복됐다.","links":[],"day":3},{"id":"n30","type":"장소","title":"김천 갈림길","body":"DAY 3 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":3},{"id":"n31","type":"사건","title":"김천에서 고른 길: 서쪽 장터길","body":"약 219km · 멀지만 장터와 보급 거점이 이어지고, 여러 사람의 증언을 싣는다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":3},{"id":"n32","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":3},{"id":"n33","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 181km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n34","type":"장소","title":"무주 터널","body":"DAY 3 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":3},{"id":"n35","type":"사건","title":"호송 기록: 잠든 자동 검문소","body":"지형: 좁은 국도와 폐차 차양, 고장 난 차단봉\n처음 목표: 다섯 수레를 기록 없이 통과시킨다\n실패 위험: 행렬이 끊기면 센서가 사람 수를 센다\n읽어낸 틈: 센서가 한 차량으로 보는 긴 윤곽\n행렬 세우기 — 편성: 수레를 달구지 뒤에 한 줄로 묶는다\n센서 속이기 — 위장: 천막과 반사판으로 차량 윤곽을 잇는다\n통과시키기 — 차체 지지: 달구지로 봉을 받치고 수레를 밀어낸다\n결과: 종료. 차체 82/100, 관측 1/5.","links":["달구지","천리안"],"day":3},{"id":"n36","type":"사건","title":"기록에 남은 행렬","body":"차단봉이 떨어져 씨앗 두 자루를 잃었고 장터 사람들의 이동 기록이 중앙망에 남았다. 다음 장이 열릴지는 아무도 장담하지 못했다.","links":["천리안"],"day":3},{"id":"n37","type":"인물","title":"강우 · 비워 둔 순번","body":"내일의 경계를 나눠 맡고 쉴 순번도 적는다. 접힌 지도에 경계와 휴식 순번을 함께 적었다. 강우가 쉬는 칸도 있다.","links":["강우","달구지"],"day":3},{"id":"n38","type":"인물","title":"점례","body":"터널 약초 할매. 무주 터널의 사람.","links":["무주 터널"],"day":4},{"id":"n39","type":"사건","title":"이중 봉투","body":"\"아직 남산 아니지 않냐.\" 손주를 정확히 아는 이중 포장. 속봉투는 남산까지.","links":["할아버지","남산"],"day":4},{"id":"n40","type":"장소","title":"전주 서문 시장","body":"DAY 4 도착. 서쪽 최대 정착지. 음식 냄새가 나는 마지막 도시.","links":[],"day":4},{"id":"n41","type":"인물","title":"박 선생","body":"전주 서문의 진료 버스를 지키던 전직 약사. 구미 쪽 진료소로 식기 전 약을 옮겨야 한다.","links":["박 선생","전주 서문 시장"],"day":4}],"noteSeq":42,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":16,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":3,"met":true,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":3,"met":true,"chat":[]},"jeomrye":{"att":3,"met":true,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":263.0000000000007,"events":24,"nonlethal":0},"routePlan":{"id":"market","status":"active","chosenDay":3,"startedKm":170,"visited":["gimcheon","muju","jeonju"]},"thirst":0,"hunger":0,"ended":false,"seed":276001,"fatigue":33.55044,"_dlv":2,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":4,"_lunchDay":4,"_storyQueue":[],"_recentEvents":["cell_dome_meet","story_bridge_trace_gap","rq_kangwoo_join","talk_kw_02","ev_broadcast_station","levy_office","route_mid_fork","parents_diversion_manifest","salvage_claim","route_market_convoy","route_market_mask","route_market_pass","talk_kw_19","story_bridge_watched","gp_envelope","meet_bus"],"_recentEventTypes":["호송","호송","대화","위기","동행","조우"],"_eventBreather":3,"_beatQueue":["history_transit_day","story_generation_form","history_seventy_two_hours","story_family_principle","story_generation_speech","history_three_day_silence","parents_separated_work","history_first_recorders","story_generation_theories","history