[
  {
    "kind": "narration",
    "text": "그날부터 지도 낭독 담당이 됐다. 박 선생은 듣고, 나는 읽고."
  },
  {
    "kind": "dialogue",
    "who": "parkss",
    "text": "거기 갈림길 지명 뭐라고 했나."
