[
  {
    "kind": "narration",
    "text": "답에 따라 처방이 나왔다. 물 한 잔이거나, 스트레칭이거나,"
  },
  {
    "kind": "dialogue",
    "who": "parkss",
    "text": "오늘은 일찍 자"
