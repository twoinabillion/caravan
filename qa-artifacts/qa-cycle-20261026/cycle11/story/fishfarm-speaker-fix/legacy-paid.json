{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":3,"min":510,"at":"sangju","driving":null,"fuel":40.32605666666664,"fuelMax":70,"water":12,"waterMax":28,"food":9,"foodMax":24,"scrap":90,"van":90,"vanMax":100,"vanName":"달구지","items":{"부품":5,"의약품":1,"탄약":0},"party":[],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","mall","reststop","drivein"],"visited":["busan","yangsan","miryang","daegu","gumi","gimcheon","sangju"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"cell_sea":true,"first_order_trace":true,"parent_signature_match":true,"bridge_departure_echo":true,"rumor_taeho":true,"rumor_sera":true,"rumor_mansu":true,"taeho_story":true,"bridge_trace_gap":true,"massacre_known":true,"parents_split_known":true,"route_ridge_saved":true},"pursuit":0,"used":["cell_sea_meet","ev_truck_cafe","onboarding_first_road","exp_gas","memory_busan_terminal","story_bridge_departure_echo","npc_taeho_2","story_bridge_trace_gap","ev_broadcast_station","levy_office","route_mid_fork","parents_diversion_manifest","salvage_claim","route_ridge_rescue","route_ridge_anchor","route_ridge_extract","exp_fishfarm"],"quest":null,"recruitQ":null,"wx":"clear","wxNext":"fog","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"한 줄로 남기지 않는 항로","body":"해도의 배들은 출항 시각·포구·운반선을 나눠 감시 기록이 하나의 이동 경로로 이어지지 않게 한다.","links":["천리안","저항 연대망"],"day":1},{"id":"n11","type":"소문","title":"옥상 커피나무","body":"북쪽 어느 옥상에서 커피를 재배하는 사람이 있다. 트럭 카페 주인 제보.","links":[],"day":1},{"id":"n12","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n16","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n17","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n18","type":"장소","title":"대구 돔 시장","body":"DAY 1 도착. 야구장 지붕 아래 남부 최대의 시장이 산다.","links":[],"day":1},{"id":"n19","type":"소문","title":"태호의 소문","body":"구미 쪽 백화점 말이야, 다들 털렸다고 하는데 지하 창고는 아무도 못 열었대. 셔터가 내려져 있거든. 정비 도구가 있으면 얘기가 다르겠지만.","links":["유령 백화점","태호"],"day":2},{"id":"n20","type":"소문","title":"세라의 소문","body":"왜관 쪽 고속도로에 휴게소가 통째로 잠들어 있대요. 셔터 내린 그대로요. 호두과자 기계까지 그대로라던데— 믿거나 말거나. 지도에 표시해 드릴게요. 책 손님 특전.","links":["잠든 휴게소","세라"],"day":2},{"id":"n21","type":"소문","title":"만수의 소문","body":"구미 지나서 폐 자동차극장 하나 있다. 달 뜨면 스크린이 그렇게 하얗다 카더라. 나는 거기서 한 번 공연했지. 관객은 셋이었는데 박수는 삼십 명 몫을 치더라.","links":["달빛 자동차극장","만수"],"day":2},{"id":"n22","type":"인물","title":"태호의 규칙 하나","body":"돔의 첫 주, 배급 줄 싸움으로 셋을 잃었다. 그래서 규칙은 하나— 싸우지 마라. 제일 어려운 것 하나.","links":["태호","천리안"],"day":2},{"id":"n23","type":"장소","title":"구미 공단 폐허","body":"DAY 2 도착. 멈춘 공장들. 굴뚝 하나에서 이유 모를 연기가 오른다.","links":[],"day":2},{"id":"n24","type":"사건","title":"반복된 마지막 속보","body":"첫 정리 이후에도 서울 추방 방송은 여러 세대에 걸쳐 반복됐다.","links":[],"day":2},{"id":"n25","type":"사건","title":"가짜 행정소","body":"관공서를 흉내 낸 통행세 사기. 꺼진 태블릿을 가리키자 물러섰다. 다음 차는 속을지도 모른다.","links":[],"day":2},{"id":"n26","type":"장소","title":"김천 갈림길","body":"DAY 2 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":2},{"id":"n27","type":"사건","title":"김천에서 고른 길: 동쪽 능선길","body":"약 130km · 빠르지만 험로가 많고, 구조할 사람을 외면하기 어렵다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":2},{"id":"n28","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":2},{"id":"n29","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n30","type":"장소","title":"상주 자전거길","body":"DAY 2 도착. 자전거의 도시. 기름 없는 세상에서 뒤늦게 전성기를 맞았다.","links":[],"day":2},{"id":"n31","type":"사건","title":"구조 기록: 비탈에 걸린 우편 수레","body":"지형: 젖은 절개지와 무너진 돌망\n처음 목표: 네 사람을 도로로 올린다\n실패 위험: 비탈이 다시 움직이기 전에 끝내야 한다\n읽어낸 틈: 한 줄이 흔들릴 때 받쳐 줄 보조 하중\n멈춰 세우기 — 고정: 달구지를 바위 뒤에 걸고 견인줄을 내린다\n길 만들기 — 장비: 견인줄을 두 갈래로 묶어 흔들림을 잡는다\n꺼내기 — 분리 인양: 사람과 수레에 줄을 다시 걸어 나눠 당긴다\n결과: 목표 달성. 차체 86/100, 관측 0/5.","links":["달구지","천리안"],"day":2},{"id":"n32","type":"사건","title":"능선 아래 네 사람","body":"달구지를 닻으로 삼아 네 사람과 문경행 해열제를 함께 올렸다.","links":["달구지"],"day":2},{"id":"n33","type":"사건","title":"수조의 주인","body":"초대형 잉어는 방생. \"쟤는 이 수조의 주인이다.\"","links":[],"day":3}],"noteSeq":34,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":8,"met":false,"chat":[]},"taeho":{"att":9,"met":true,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":5,"met":true,"chat":[]},"mansu":{"att":5,"met":true,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":196.0000000000006,"events":17,"nonlethal":1},"routePlan":{"id":"ridge","status":"active","chosenDay":2,"startedKm":170,"visited":["gimcheon","sangju"]},"thirst":0,"hunger":0,"ended":false,"seed":269003,"fatigue":4.752,"_dlv":2,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":3,"_lunchDay":2,"_storyQueue":[],"_recentEvents":["ev_truck_cafe","onboarding_first_road","exp_ga