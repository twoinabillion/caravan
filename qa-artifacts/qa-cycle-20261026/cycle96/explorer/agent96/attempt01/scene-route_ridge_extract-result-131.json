ersion_manifest","story_bridge_watched","route_ridge_rescue","route_ridge_anchor","route_ridge_extract"],"quest":null,"recruitQ":null,"wx":"clear","wxNext":"clear","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"부산에서 막힌 이의 제기","body":"도윤 가족의 이송표와 원격 이의 거절 응답을 함께 복사했다. 현장 확인 주소는 남산 중앙 노드였다.","links":["도윤의 가족","남산","천리안"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"사건","title":"자갈치 건어물","body":"\"마른 것들은 배신 안 한데이.\" 부산의 마지막 배웅.","links":[],"day":1},{"id":"n11","type":"인물","title":"자전거 우편부","body":"주소 대신 이름과 얼굴로 배달한다. 여러 해째 수신인을 찾는 중.","links":[],"day":1},{"id":"n12","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n16","type":"소문","title":"의뢰: 세 마을의 무전 1/3 · 끊긴 중계소의 호출 장부","body":"밀양 장터에서 맡은 연속 이야기. 무주 터널까지. 사례는 고철 16. 서두르기보다 끝까지 이어 가기로 했다.","links":["무주 터널"],"day":1},{"id":"n17","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n18","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n19","type":"장소","title":"합천 과수원","body":"DAY 1 도착. 주인 잃은 사과나무들이 제멋대로 열매를 맺는다.","links":[],"day":1},{"id":"n20","type":"장소","title":"거창 분지","body":"DAY 2 도착. 산으로 둘러싸인 분지. 안개가 자주 고인다.","links":[],"day":2},{"id":"n21","type":"사건","title":"가짜 행정소","body":"관공서를 흉내 낸 통행세 사기. 꺼진 태블릿을 가리키자 물러섰다. 다음 차는 속을지도 모른다.","links":[],"day":2},{"id":"n22","type":"장소","title":"무주 터널","body":"DAY 2 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":2},{"id":"n23","type":"사건","title":"배달 완료: 세 마을의 무전 1/3 · 끊긴 중계소의 호출 장부","body":"밀양 장터 → 무주 터널. 사례 고철 16. 받은 이의 얼굴이 밝아졌다.","links":[],"day":2},{"id":"n24","type":"소문","title":"재필의 소문","body":"옆 터널에 책 미친 영감이 살아. 도서관을 통째로 옮겨놨지. 책 한 권 가져가면 얘기 하나를 들려준다더군. 세상이 왜 이렇게 됐는지에 대한 얘기도.","links":["책의 터널","재필"],"day":2},{"id":"n25","type":"소문","title":"점례의 소문","body":"첫서리 오기 전에 북쪽 고개를 넘어. 무주 눈은 한번 오면 길을 통째로 지워버려. 작년에 늦게 넘은 차가 봄에야 발견됐어. …차만.","links":["점례"],"day":2},{"id":"n26","type":"인물","title":"재필의 116개 촛불","body":"식구 92 + 떠난 사람 24. 나간 사람의 촛불은 끄지 않는다. 터널은 등대였다.","links":["재필"],"day":2},{"id":"n27","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n28","type":"장소","title":"김천 갈림길","body":"DAY 2 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":2},{"id":"n29","type":"사건","title":"김천에서 고른 길: 동쪽 능선길","body":"약 130km · 빠르지만 험로가 많고, 구조할 사람을 외면하기 어렵다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":2},{"id":"n30","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":2},{"id":"n31","type":"장소","title":"상주 자전거길","body":"DAY 2 도착. 자전거의 도시. 기름 없는 세상에서 뒤늦게 전성기를 맞았다.","links":[],"day":2},{"id":"n32","type":"사건","title":"구조 기록: 비탈에 걸린 우편 수레","body":"지형: 젖은 절개지와 무너진 돌망\n처음 목표: 네 사람을 도로로 올린다\n실패 위험: 비탈이 다시 움직이기 전에 끝내야 한다\n읽어낸 틈: 무너진 자리라 발 디딜 곳을 못 믿는다\n멈춰 세우기 — 고정: 달구지를 바위 뒤에 걸고 견인줄을 내린다\n길 만들기 — 토공: 삽으로 하중을 나눌 계단을 판다\n꺼내기 — 분리 인양: 사람과 수레에 줄을 다시 걸어 나눠 당긴다\n결과: 부분 달성. 차체 81/100, 관측 2/5.","links":["달구지","천리안"],"day":2},{"id":"n33","type":"사건","title":"능선 아래 네 사람","body":"네 사람은 모두 구했다. 약 상자는 절반만 건졌지만, 우선순위는 끝까지 바뀌지 않았다.","links":["달구지"],"day":2}],"noteSeq":34,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":4,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":15,"met":true,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":false,"chat":[]},"jeomrye":{"att":11,"met":true,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":233.00000000000102,"events":17,"nonlethal":1},"routePlan":{"id":"ridge","status":"active","chosenDay":2,"startedKm":207,"visited":["gimcheon","sangju"]},"thirst":0,"hunger":0,"ended":false,"seed":961187,"fatigue":81.52940000000008,"_dlv":2,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":2,"_lunchDay":2,"_storyQueue":[],"_recentEvents":["meet_postman","onboarding_first_road