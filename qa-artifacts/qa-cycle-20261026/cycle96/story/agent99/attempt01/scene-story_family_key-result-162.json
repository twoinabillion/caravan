rue,"trace_registry":true,"parents_split_known":true,"parent_principle_found":true,"route_market_escorted":true,"parents_routes_traced":true,"parent_key_located":true},"pursuit":0,"used":["meet_postman","onboarding_first_road","memory_busan_terminal","story_bridge_departure_echo","story_bridge_trace_gap","levy_office","salvage_claim","meet_bus","story_bridge_watched","ev_broadcast_station","crisis_drowsy","story_generation_form","route_mid_fork","parents_diversion_manifest","story_family_principle","route_market_convoy","route_market_mask","route_market_pass","parents_separated_work","story_family_key"],"quest":null,"recruitQ":{"id":"parkss","stage":"task","target":"gumi","startedDay":2,"metAt":"jeonju","sameStop":false,"escort":true},"wx":"fog","wxNext":"clear","up":{},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"고철 연결 고리로 유나가 탄 이송 버스의 난방을 살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"우편부의 지름길","body":"물 반 잔의 답례. 어느 고개의 지름길.","links":[],"day":1},{"id":"n11","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n12","type":"본편","title":"검문소 저장 모듈","body":"이송 대상을 다시 고르는 규칙과 부모님 이송표로 이어지는 검증 번호를 찾아냈다.","links":["부모님","천리안","남산"],"day":1},{"id":"n13","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":1},{"id":"n14","type":"장소","title":"밀양 장터","body":"DAY 1 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":1},{"id":"n15","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":1},{"id":"n16","type":"세대의 흔적","title":"2026년 교통카드 번호표","body":"대중교통을 타던 카드는 143년 뒤 밀양 장터의 국수 대기 번호표가 되었다. 기능은 잊혔지만 차례를 지키는 용도만은 남았다.","links":["밀양 장터","2026년"],"day":1},{"id":"n17","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":1},{"id":"n18","type":"장소","title":"합천 과수원","body":"DAY 1 도착. 주인 잃은 사과나무들이 제멋대로 열매를 맺는다.","links":[],"day":1},{"id":"n19","type":"장소","title":"거창 분지","body":"DAY 1 도착. 산으로 둘러싸인 분지. 안개가 자주 고인다.","links":[],"day":1},{"id":"n20","type":"장소","title":"남원 광한루","body":"DAY 2 도착. 무너진 누각 옆에서 누군가 판소리를 연습하고 있었다는 소문.","links":[],"day":2},{"id":"n21","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 181km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n22","type":"사건","title":"구역이라는 말","body":"무너진 창고 앞에서 회수료를 냈다. 남은 물건보다 허가증이 비쌌다.","links":[],"day":2},{"id":"n23","type":"장소","title":"전주 서문 시장","body":"DAY 2 도착. 서쪽 최대 정착지. 음식 냄새가 나는 마지막 도시.","links":[],"day":2},{"id":"n24","type":"세대의 흔적","title":"문 앞에 놓인 국밥","body":"2026년 배달 가방이 세대를 지나 아픈 집에 국밥을 나르는 공동 가방으로 쓰였다.","links":["전주 서문 시장","2026년"],"day":2},{"id":"n25","type":"인물","title":"박 선생","body":"전주 서문의 진료 버스를 지키던 전직 약사. 구미 쪽 진료소로 따뜻해지기 전에 약을 옮겨야 한다.","links":["박 선생","전주 서문 시장"],"day":2},{"id":"n26","type":"사건","title":"반복된 마지막 속보","body":"첫 정리 이후에도 서울 추방 방송은 여러 세대에 걸쳐 반복됐다.","links":[],"day":2},{"id":"n27","type":"장소","title":"무주 터널","body":"DAY 3 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":3},{"id":"n28","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 300km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n29","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":3},{"id":"n30","type":"장소","title":"김천 갈림길","body":"DAY 3 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":3},{"id":"n31","type":"사건","title":"김천에서 고른 길: 서쪽 장터길","body":"약 219km · 멀지만 장터와 보급 거점이 이어지고, 여러 사람의 증언을 싣는다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":3},{"id":"n32","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":3},{"id":"n33","type":"사건","title":"예측은 명령이 아니다","body":"부모님의 발표 연습 영상에서 엄마의 발언을 복원했다. 천리안은 사람을 미래 파급으로 평가했고, 부모는 이유 공개·인간 서명·이의 제기를 되돌리려 했다.","links":["천리안","부모님의 검증키"],"day":3},{"id":"n34","type":"사건","title":"호송 기록: 잠든 자동 검문소","body":"지형: 좁은 국도와 폐차 차양, 고장 난 차단봉\n처음 목표: 다섯 수레를 기록 없이 통과시킨다\n실패 위험: 행렬이 끊기면 센서가 사람 수를 센다\n읽어낸 틈: 센서가 한 차량으로 보는 긴 윤곽\n행렬 세우기 — 편성: 수레를 달구지 뒤에 한 줄로 묶는다\n센서 속이기 — 위장: 천막과 반사판으로 차량 윤곽을 잇는다\n통과시키기 — 인력 릴레이: 짐 높이를 낮추고 전원이 손으로 넘긴다\n결과: 목표 달성. 차체 79/100, 관측 0/5.","links":["달구지","천리안"],"day":3},{"id":"n35","type":"사건","title":"두 곳에서 만든 한 절차","body":"아버지가 남산 유지선에 분리 절차를 나누어 숨겼음을 확인했다.","links":[],"day":3},{"id":"n36","type":"사건","title":"실행 전 인간 확인","body":"달구지 계기판의 숨은 모듈을 확인하고 배선 위치를 표시했다. 뜯긴 분리 절차를 찾을 때까지 그대로 보존한다.","links":["천리안","할아버지"],"day":3}],"noteSeq":37,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":12,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil"