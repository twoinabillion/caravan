{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":4,"min":1184.2,"at":null,"driving":{"from":"gimcheon","to":"muju","dist":38,"gone":26.454999999999984,"road":"rough","wx":"clear","slots":[{"at":25.653333333333336,"beat":true}],"si":1,"eventCount":2,"snapshot":{"gameMinute":6822.1,"fuel":54.06454666666686,"water":26,"food":20,"scrap":103,"van":91.95999999999978,"fatigue":37.02078999999997,"pursuit":0,"build":"관측 선행형"}},"fuel":48.217991666666826,"fuelMax":70,"water":26,"waterMax":28,"food":20,"foodMax":24,"scrap":103,"van":90.37269999999961,"vanMax":100,"vanName":"달구지","items":{"부품":6,"의약품":1,"탄약":0},"party":[],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","lake","sunflower","mall","reststop","drivein"],"visited":["busan","yangsan","miryang","lake","daegu","gumi","gimcheon"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"cell_sea":true,"coffee_found":true,"first_order_trace":true,"parent_signature_match":true,"miryang_oldcard":true,"rumor_sundeok":true,"rumor_byungchul":true,"rumor_yeongok":true,"sundeok_son":true,"bridge_departure_echo":true,"trace_registry":true,"rumor_taeho":true,"rumor_sera":true,"rumor_mansu":true,"daegu_ticketbox":true,"bridge_trace_gap":true,"massacre_known":true,"parents_split_known":true},"pursuit":0,"used":["lc_busan_dried","cell_sea_meet","ev_truck_cafe","onboarding_first_road","memory_busan_terminal","npc_sundeok_2","story_bridge_departure_echo","loc_lake","camp_dogs","ev_mart_warehouse","story_generation_form","story_bridge_trace_gap","ev_broadcast_station","levy_office","route_mid_fork","parents_diversion_manifest","lc_yeongdong_wine","salvage_claim"],"quest":null,"recruitQ":null,"wx":"clear","wxNext":"dust","up":{"antenna":true},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"새벽의 수리 호출","body":"감천 작업장을 비우고 난방이 멈춘 이송 버스로 향했다.","links":["달구지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"부산에서 막힌 이의 제기","body":"도윤 가족의 이송표와 원격 이의 거절 응답을 함께 복사했다. 현장 확인 주소는 남산 중앙 노드였다.","links":["도윤의 가족","남산","천리안"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"엄마의 회로도와 아빠가 만든 검증키를 확인했다. 분리 절차 두 장을 찾을 때까지 계기판에 연결해 둔다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"맡겨 둔 작업장 열쇠","body":"감천의 단골에게 공구함 열쇠를 맡기고 북쪽으로 출발했다. 돌아오면 다시 셔터를 열 수 있다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"사건","title":"자갈치 건어물","body":"\"마른 것들은 배신 안 한데이.\" 부산의 마지막 배웅.","links":[],"day":1},{"id":"n11","type":"인물","title":"해도 — 김 선장","body":"항구 밖 중계 공백과 포구별 분산 운송을 이용하는 바닷길 연대. 북쪽에서 육로가 막힐 때 쓸 접선 표식을 받았다.","links":["저항 연대망"],"day":1},{"id":"n12","type":"장소","title":"양산 고가차도","body":"DAY 1 도착. 무너진 고가 아래로 길이 하나 살아 있다. 콘크리트 기둥 사이로 북쪽 국도가 이어진다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"사건","title":"부산 터미널의 마지막 불","body":"부산 터미널에서 부모님의 다음 차를 오래 기다렸다.","links":[],"day":2},{"id":"n15","type":"장소","title":"밀양 장터","body":"DAY 2 도착. 닷새마다 장이 선다. 멸망 이후에도 장날은 살아남았다.","links":[],"day":2},{"id":"n16","type":"사건","title":"밀양의 부품 천막","body":"경운기와 자전거 부품을 함께 분류하고 달구지에 맞는 체결 부품 하나를 품삯으로 받았다.","links":["밀양 장터","달구지"],"day":2},{"id":"n17","type":"세대의 흔적","title":"2026년 교통카드 번호표","body":"대중교통을 타던 카드는 143년 뒤 밀양 장터의 국수 대기 번호표가 되었다. 기능은 잊혔지만 차례를 지키는 용도만은 남았다.","links":["밀양 장터","2026년"],"day":2},{"id":"n18","type":"소문","title":"순덕의 소문","body":"북쪽 호수에 낚시꾼 영감이 혼자 사는데, 지나가는 사람한테 민물고기를 나눠준다더군. 밀양서 산길로 조금만 올라가면 돼.","links":["낚시꾼의 호수","순덕"],"day":2},{"id":"n19","type":"소문","title":"병철의 소문","body":"강 상류에서 정리자들이 뭘 건져 올리더라. 흰 옷 넷이서, 밤에, 등도 없이. 건진 게 뭔지는 안 보이더라만— 사람 크기였다. 상류 쪽에선 밤낚시 하지 마라.","links":["병철"],"day":2},{"id":"n20","type":"소문","title":"영옥의 소문","body":"창녕 쪽 폐도로 옆에 해바라기 밭이 살아 있다 카더라. 씨 받으러 가는 사람들이 있어. 기름도 짜고. 눈 호강은 덤이고. 가을 전에 가 봐라.","links":["해바라기 밭","영옥"],"day":2},{"id":"n21","type":"인물","title":"순덕의 막내","body":"수원 성곽의 화살수. 순덕의 부탁: 밥 잘 먹고 다니는지만 봐줄 것. 전언은 금지.","links":["순덕","수원"],"day":2},{"id":"n22","type":"장소","title":"낚시꾼의 호수","body":"DAY 2 도착. 댐 호수. 혼자 사는 낚시꾼이 물고기를 나눠준다는 소문.","links":[],"day":2},{"id":"n23","type":"사건","title":"호숫가 낚시","body":"낚시꾼과 오래 나란히 앉아 있었다. 낚싯대를 접으며 말린 생선 꾸러미를 받았다.","links":[],"day":3},{"id":"n24","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":3},{"id":"n25","type":"사건","title":"세 겹의 이송표","body":"한 집안 세 세대가 서로 다른 서울 구역에서 서로 다른 해에 쫓겨났다. 가설을 답처럼 쓰지 않고 빈 사유란까지 기록했다.","links":["서울 추방","천리안"],"day":3},{"id":"n26","type":"장소","title":"대구 돔 시장","body":"DAY 3 도착. 야구장 지붕 아래 남부 최대의 시장이 산다.","links":[],"day":3},{"id":"n27","type":"소문","title":"의뢰: 부품 2개 조달","body":"대구 돔 시장에서 맡은 조달 의뢰. 구해서 돌아올 것. 사례는 고철 20. 기한 9일차.","links":["대구 돔 시장"],"day":3},{"id":"n28","type":"사건","title":"조달 완료: 부품 2개 조달","body":"대구 돔 시장 → 대구 돔 시장. 사례 고철 24. 받은 이의 얼굴이 밝아졌다.","links":[],"day":3},{"id":"n29","type":"소문","title":"태호의 소문","body":"구미 쪽 백화점 말이야, 다들 털렸다고 하는데 지하 창고는 아무도 못 열었대. 셔터가 내려져 있거든. 정비 도구가 있으면 얘기가 다르겠지만.","links":["유령 백화점","태호"],"day":3},{"id":"n30","type":"소문","title":"세라의 소문","body":"왜관 쪽 고속도로에 휴게소가 통째로 잠들어 있대요. 셔터 내린 그대로요. 호두과자 기계까지 그대로라던데— 믿거나 말거나. 지도에 표시해 드릴게요. 책 손님 특전.","links":["잠든 휴게소","세라"],"day":3},{"id":"n31","type":"소문","title":"만수의 소문","body":"구미 지나서 폐 자동차극장 하나 있다. 달 뜨면 스크린이 그렇게 하얗다 카더라. 나는 거기서 한 번 공연했지. 관객은 셋이었는데 박수는 삼십 명 몫을 치더라.","links":["달빛 자동차극장","만수"],"day":3},{"id":"n32","type":"사건","title":"다시 켜진 돔 전광판","body":"경기장이던 돔의 전광판은 지금 물자 도착과 미아 이름을 알린다. 끊어진 배선을 고쳐 한 구역을 되살렸다.","links":["대구 돔 시장"],"day":3},{"id":"n33","type":"세대의 흔적","title":"돔의 좌석 번호","body":"야구장 입장권의 좌석 번호가 시장에서 가족을 다시 찾는 번호표로 남았다.","links":["대구 돔 시장","2026년"],"day":3},{"id":"n34","type":"사건","title":"달구지 개조: 장거리 안테나","body":"발견 이벤트가 잘 잡힌다 · 지붕 자리 사용 — 달구지가 조금 더 우리 집이 됐다.","links":[],"day":3},{"id":"n35","type":"장소","title":"구미 공단 폐허","body":"DAY 4 도착. 멈춘 공장들. 굴뚝 하나에서 이유 모를 연기가 오른다.","links":[],"day":4},{"id":"n36","type":"사건","title":"반복된 마지막 속보","body":"첫 정리 이후에도 서울 추방 방송은 여러 세대에 걸쳐 반복됐다.","links":[],"day":4},{"id":"n37","type":"사건","title":"가짜 행정소","body":"관공서를 흉내 낸 통행세 사기. 꺼진 태블릿을 가리키자 물러섰다. 다음 차는 속을지도 모른다.","links":[],"day":4},{"id":"n38","type":"장소","title":"김천 갈림길","body":"DAY 4 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":4},{"id":"n39","type":"사건","title":"김천에서 고른 길: 서쪽 장터길","body":"약 219km · 멀지만 장터와 보급 거점이 이어지고, 여러 사람의 증언을 싣는다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":4},{"id":"n40","type":"사건","title":"오지 않은 다음 차","body":"부모님이 기술 경력에 따라 서로 다른 이송선으로 보내졌음을 확인했다.","links":[],"day":4},{"id":"n41","type":"사건","title":"와인 터널의 사연","body":"술이 아니라 사연을 저장하는 터널. 할아버지 얘기를 짧게 적었다.","links":["할아버지"],"day":4}],"noteSeq":42,"npcs":{"geumja":{"att":0,"met":false,"chat":[]},"sundeok":{"att":17,"met":true,"chat":[]},"taeho":{"att":23,"met":true,"chat":[]},"jaepil":{"att":0,"met":false,"chat":[]},"miyoung":{"att":0,"met":false,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":0,"met":false,"chat":[]},"byungchul":{"att":5,"met":true,"chat":[]},"yeongok":{"att":5,"met":true,"chat":[]},"sera":{"att":11,"met":true,"chat":[]},"mansu":{"att":11,"met":true,"chat":[]},"jeomrye":{"att":0,"met":false,"chat":[]},"dongsu":{"att":0,"met":false,"chat":[]},"noah":{"att":0,"met":false,"chat":[]},"hwasun":{"att":0,"met":false,"chat":[]},"gitae":{"att":0,"met":false,"chat":[]}},"stats":{"km":178.45500000000044,"events":18,"nonlethal":0},"routePlan":{"id":"market","status":"active","chosenDay":4,"startedKm":152,"visited":["gimcheon"]},"thirst":0,"hunger":0,"ended":false,"seed":272002,"fatigue":47.14176999999982,"_dlv":1,"_drowsyDay":0,"_drowsyAt":-999,"_breakfastDay":4,"_lunchDay":4,"_storyQueue":["route_market_convoy"],"_recentEvents":["ev_truck_cafe","onboarding_first_road","memory_busan_terminal","npc_sundeok_2","story_bridge_departure_echo","loc_lake","camp_dogs","ev_mart_warehouse","story_generation_form","story_bridge_trace_gap","ev_broadcast_station","levy_office","route_mid_fork","parents_diversion_manifest","lc_yeongdong_wine","salvage_claim"],"_recentEventTypes":["탐색","조우","스토리","스토리","탐색","조우"],"_eventBreather":3,"_beatQueue":["history_transit_day","history_seventy_two_hours","story_family_principle","story_br