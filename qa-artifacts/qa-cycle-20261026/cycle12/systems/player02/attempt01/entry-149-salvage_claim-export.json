 만들면 우리가 뺏고.\"","view":null,"reading":null},"_chain":null,"_lastNarrativeLeg":"4:null>muju","_simDeferred":["route_mid_fork"],"_lastPursuitUp":3,"_campPlan":{},"_strandedDays":0,"_shunnedDays":0,"_crewChatSeen":{},"storyQuests":{"completed":[],"active":null}}