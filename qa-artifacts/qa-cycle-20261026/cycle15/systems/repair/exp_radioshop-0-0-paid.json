{"v":9,"mode":"onroad","entryMode":"interactive","name":"상혁","day":7,"min":510,"at":"muju","driving":null,"fuel":66.36964979999951,"fuelMax":95,"water":28,"waterMax":28,"food":20,"foodMax":24,"scrap":51,"van":87.11999999999891,"vanMax":100,"vanName":"달구지","items":{"부품":4,"의약품":1,"탄약":0},"party":[],"comps":{"minji":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"parkss":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"kangwoo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"leo":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"jaeyi":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0},"eunsu":{"mood":65,"bond":0,"lvl":0,"perks":[],"pending":0}},"dog":false,"_scrapKm":0,"known":["busan","gimhae","yangsan","miryang","jinju","hapcheon","geochang","daegu","gumi","gimcheon","muju","namwon","jeonju","yeongdong","daejeon","nonsan","gongju","cheongju","cheonan","pyeongtaek","suwon","seoul","ulsan","yeosu","suncheon","gwangju","damyang","mokpo","andong","mungyeong","danyang","wonju","daegwallyeong","gangneung","sokcho","icheon","gyeongju","pohang","sangju","gunsan","chungju","sejong","maehwa","tower","airfield","lighthouse","tunnelbook"],"visited":["busan","gimhae","jinju","namwon","damyang","gwangju","jeonju","muju","gimcheon"],"flags":{"mother_keepsakes":true,"intro_family_helped":true,"intro_appeal_failed":true,"intro_module_seen":true,"intro_workshop_left":true,"recruit_migration_v2":true,"opening_call_answered":true,"main_mission_started":true,"cell_sea":true,"postman_met":true,"first_order_trace":true,"parent_signature_match":true,"bridge_departure_echo":true,"rumor_geumja":true,"rumor_suwan":true,"cell_sotgot":true,"rumor_miyoung":true,"rumor_dongsu":true,"jeonju_coldbag":true,"bridge_trace_gap":true,"massacre_known":true,"rumor_jaepil":true,"rumor_jeomrye":true,"jaepil_candles":true,"bridge_watched":true,"parents_split_known":true,"trace_registry":true,"route_market_escorted":true},"pursuit":1,"used":["lc_busan_dried","cell_sea_meet","meet_postman","onboarding_first_road","ev_convenience_store","ev_truck_cafe","memory_busan_terminal","postman_again","ev_wedding_hall_storage","crisis_nofuel","salvage_claim","crisis_drowsy","story_bridge_departure_echo","meet_hitchhiker","cell_sotgot_meet","lc_damyang_juktong","levy_office","meet_bus","lc_jeonju_bibim","story_bridge_trace_gap","ev_broadcast_station","npc_jaepil_2","story_bridge_watched","route_mid_fork","parents_diversion_manifest","story_generation_form","route_market_convoy","route_market_mask","route_market_pass","exp_radioshop"],"quest":null,"recruitQ":null,"wx":"rain","wxNext":"clear","up":{"tank1":true,"collector":true,"stove":true,"kitchen":true},"notes":[{"id":"n0","type":"장소","title":"부산 감천 부두","body":"모든 것이 시작된 곳. 달구지에 시동을 걸었다.","links":[],"day":1},{"id":"n1","type":"물건","title":"달구지","body":"낡은 한 톤 용달 트럭의 적재함에 폐자재 생활칸을 얹어 만든 이동식 집. 출발할 때는 겨우 먹고 잘 수 있는 작은 집이지만, 길에서 만날 사람에 맞춰 좌석·침대·부엌을 덧붙일 빈 틀과 볼트 자리가 남아 있다.","links":["할아버지"],"day":1},{"id":"n2","type":"인물","title":"천리안","body":"2026년 중국이 미국의 AI·반도체망을 견제하려고 아시아에 배포한 TIANYAN의 한국 지역판. 사람들은 천리안이라 불렀다. 143년 동안 서울의 정리를 집행했고, 외곽의 마지막 잔류구역에도 이송 명령을 내렸다.","links":[],"day":1},{"id":"n3","type":"인물","title":"부모님","body":"엄마는 천리안 판단 검증 연구원, 아빠는 연산망 반도체 기술자였다. 예측과 실행 사이에 인간 확인을 되돌리는 수정안을 발표하려다 사라졌다. 가족 이송표의 사유는 비어 있다.","links":["천리안"],"day":1},{"id":"n4","type":"인물","title":"할아버지","body":"나를 키운 늙은 정비사. 용달차에 생활칸을 올려 달구지를 함께 만들고 지난겨울 떠났다. 부모가 남긴 것을 끝낼 의무는 없지만, 가고 싶다면 이 차가 남산까지 갈 수 있다고 적었다.","links":["달구지","부모님"],"day":1},{"id":"n5","type":"출발","title":"닫고 나온 작업장","body":"작업장 불씨를 정리하고 예비 공구를 챙겨 이송 버스로 향했다.","links":["달구지","할아버지"],"day":1},{"id":"n6","type":"출발","title":"도윤 가족의 버스","body":"새 부품을 써서 유나가 탄 이송 버스의 난방을 빠르게 되살렸다.","links":["도윤의 가족","천리안"],"day":1},{"id":"n7","type":"출발","title":"남산 주소 옆의 세 이름","body":"하진의 허락을 받아 도윤과 유나의 이름, 비어 있는 이송 사유, 남산 현장 확인 주소를 기록했다.","links":["도윤의 가족","남산"],"day":1},{"id":"n8","type":"출발","title":"계기판 속 검증키","body":"검증키를 억지로 떼지 않고 현재 배선 경로를 회로도에 남겼다. 빠진 분리 절차 두 장을 찾아야 한다.","links":["엄마의 철제 상자","부모님","달구지","남산"],"day":1},{"id":"n9","type":"출발","title":"목에 건 작업장 열쇠","body":"감천 작업장 열쇠를 지닌 채 북쪽으로 출발했다. 돌아올 약속은 날짜 대신 열쇠로 남겼다.","links":["할아버지","달구지"],"day":1},{"id":"n10","type":"소문","title":"한 줄로 남기지 않는 항로","body":"해도의 배들은 출항 시각·포구·운반선을 나눠 감시 기록이 하나의 이동 경로로 이어지지 않게 한다.","links":["천리안","저항 연대망"],"day":1},{"id":"n11","type":"소문","title":"우편부의 지름길","body":"물 반 잔의 답례. 어느 고개의 지름길.","links":[],"day":1},{"id":"n12","type":"장소","title":"김해 들판","body":"DAY 1 도착. 민간 비행장이 있던 넓은 들판이다. 갈라진 활주로 위로 잡초가 길게 자라고, 북서쪽 유도로는 아직 바퀴가 지나갈 수 있다.","links":[],"day":1},{"id":"n13","type":"본편","title":"달구지를 걸고 받은 기록","body":"달구지가 관측망에 잡혔지만 이송 명령의 전체 발신 기록을 복사했다. 부모님의 표와 같은 곳에서 나온 명령이다.","links":["부모님","천리안","달구지","남산"],"day":1},{"id":"n14","type":"소문","title":"옥상 커피나무","body":"북쪽 어느 옥상에서 커피를 재배하는 사람이 있다. 트럭 카페 주인 제보.","links":[],"day":1},{"id":"n15","type":"장소","title":"진주 남강변","body":"DAY 1 도착. 강물은 그대로인데 다리는 반쪽이다. 유등 축제의 등롱 잔해가 강가에 쌓여 있다.","links":[],"day":1},{"id":"n16","type":"사건","title":"운전 숙련: 손에 익은 운전사","body":"누적 주행 80km. 핸들이 손에 붙는다.","links":[],"day":2},{"id":"n17","type":"사건","title":"부산 터미널의 마지막 불","body":"부모님이 돌아오지 않은 이유를 확인할 때까지 단정하지 않기로 했다.","links":[],"day":2},{"id":"n18","type":"인물","title":"끝까지 가는 우편부","body":"배달은 끝까지가 원칙. 자전거로 남산까지. 정말 갈 사람.","links":[],"day":2},{"id":"n19","type":"장소","title":"남원 광한루","body":"DAY 2 도착. 무너진 누각 옆에서 누군가 판소리를 연습하고 있었다는 소문.","links":[],"day":2},{"id":"n20","type":"장소","title":"담양 대숲","body":"DAY 3 도착. 대나무 숲이 바람마다 파도 소리를 낸다. 바다에서 멀수록 크게.","links":[],"day":3},{"id":"n21","type":"장소","title":"광주 대인시장","body":"DAY 3 도착. 호남 최대의 정착지. 시장 골목엔 아직 기름 냄새와 정이 흐른다.","links":[],"day":3},{"id":"n22","type":"사건","title":"대인시장의 발전기 줄","body":"세 발전기가 벨트 하나를 나눠 쓰는 시장의 교대 순서를 돕고 예비 풀리 하나를 받았다.","links":["광주 대인시장","달구지"],"day":4},{"id":"n23","type":"소문","title":"의뢰: 부품 2개 조달","body":"광주 대인시장에서 맡은 조달 의뢰. 구해서 돌아올 것. 사례는 고철 17. 기한 10일차.\n무주 터널에서 맡은 조달 의뢰. 구해서 돌아올 것. 사례는 고철 19. 기한 12일차.","links":["광주 대인시장","무주 터널"],"day":6},{"id":"n24","type":"사건","title":"조달 완료: 부품 2개 조달","body":"광주 대인시장 → 광주 대인시장. 사례 고철 21. 받은 이의 얼굴이 밝아졌다.\n무주 터널 → 무주 터널. 사례 고철 23. 받은 이의 얼굴이 밝아졌다.","links":[],"day":6},{"id":"n25","type":"소문","title":"금자의 소문","body":"섬진강 쪽에 매화마을 있는 거 아는가? 봄이면 강가가 하얗게 뒤집어져. 매실청 담그는 할매들이 아직 살어. 순천서 강길로 쬐끔만 가면 돼야.","links":["섬진강 매화마을","금자"],"day":4},{"id":"n26","type":"소문","title":"수완의 소문","body":"화순 쪽 능선에 송전탑 겸 통신탑이 서 있어. 거기 올라가면 안 잡히던 주파수가 잡혀. 나는 무릎이 이래서 못 가. 가면 테이프 하나만 감아다 줘.","links":["송전 통신탑","수완"],"day":4},{"id":"n27","type":"인물","title":"솥 — 금자","body":"국밥집=정보 허브. \"사람은 국밥 앞에선 거짓말 안 해.\" 밥상이 카메라보다 많이 안다.","links":["저항 연대망"],"day":4},{"id":"n28","type":"사건","title":"운전 숙련: 베테랑 운전사","body":"누적 주행 180km. 핸들이 손에 붙는다.","links":[],"day":4},{"id":"n29","type":"사건","title":"가짜 행정소","body":"가짜 등록증에 고철 15를 냈다. 우리 다음 차례는 소달구지 노인이었다.","links":[],"day":4},{"id":"n30","type":"장소","title":"전주 서문 시장","body":"DAY 4 도착. 서쪽 최대 정착지. 음식 냄새가 나는 마지막 도시.","links":[],"day":4},{"id":"n31","type":"소문","title":"미영의 소문","body":"논산 쪽 군 비행장, 격납고에 군수품이 남았다는 소문이 있어. 근데 아무도 안 가. 밤마다 활주로에 불이 들어온대. 착륙 유도등이. …누굴 기다리는 걸까?","links":["폐 군 비행장","미영"],"day":5},{"id":"n32","type":"소문","title":"동수의 소문","body":"서해 쪽 등대가 아직 돌아간답니다. 지키는 사람이 있다는 뜻이지요. 배도 없는 바다에 불을 켜는 이유를— 저는 알 것 같기도 합니다. 지도에 넣어 드리지요.","links":["서해 등대","동수"],"day":5},{"id":"n33","type":"세대의 흔적","title":"문 앞에 놓인 국밥","body":"2026년 배달 가방이 세대를 지나 아픈 집에 국밥을 나르는 공동 가방으로 쓰였다.","links":["전주 서문 시장","2026년"],"day":5},{"id":"n34","type":"사건","title":"달구지 개조: 보조 연료탱크","body":"연료 최대 +25L — 달구지가 조금 더 우리 집이 됐다.","links":[],"day":5},{"id":"n35","type":"사건","title":"달구지 개조: 빗물 집수기","body":"매일 아침 물 +1 (비·폭풍 +2) · 지붕 자리 사용 — 달구지가 조금 더 우리 집이 됐다.","links":[],"day":5},{"id":"n36","type":"사건","title":"반복된 마지막 속보","body":"첫 정리 이후에도 서울 추방 방송은 여러 세대에 걸쳐 반복됐다.","links":[],"day":5},{"id":"n37","type":"장소","title":"무주 터널","body":"DAY 6 도착. 산속 터널에 숨어 사는 공동체. 낯선 이를 반기지 않는다.","links":[],"day":6},{"id":"n38","type":"소문","title":"재필의 소문","body":"옆 터널에 책 미친 영감이 살아. 도서관을 통째로 옮겨놨지. 책 한 권 가져가면 얘기 하나를 들려준다더군. 세상이 왜 이렇게 됐는지에 대한 얘기도.","links":["책의 터널","재필"],"day":6},{"id":"n39","type":"소문","title":"점례의 소문","body":"첫서리 오기 전에 북쪽 고개를 넘어. 무주 눈은 한번 오면 길을 통째로 지워버려. 작년에 늦게 넘은 차가 봄에야 발견됐어. …차만.","links":["점례"],"day":6},{"id":"n40","type":"사건","title":"달구지 개조: 장작 난로","body":"야영 사기 +2 (비 오는 밤엔 +3) — 달구지가 조금 더 우리 집이 됐다.","links":[],"day":6},{"id":"n41","type":"사건","title":"달구지 개조: 간이 주방","body":"난로 확장 — 식사 때마다 사기 +1 — 달구지가 조금 더 우리 집이 됐다.","links":[],"day":6},{"id":"n42","type":"인물","title":"재필의 116개 촛불","body":"식구 92 + 떠난 사람 24. 나간 사람의 촛불은 끄지 않는다. 터널은 등대였다.","links":["재필"],"day":6},{"id":"n43","type":"사건","title":"운전 숙련: 길의 장인","body":"누적 주행 300km. 핸들이 손에 붙는다.","links":[],"day":6},{"id":"n44","type":"장소","title":"김천 갈림길","body":"DAY 6 도착. 고속도로와 국도가 엉키는 곳. 표지판이 전부 뽑혀 있다.","links":[],"day":6},{"id":"n45","type":"사건","title":"김천에서 고른 길: 서쪽 장터길","body":"약 219km · 멀지만 장터와 보급 거점이 이어지고, 여러 사람의 증언을 싣는다. 청주에서 길이 다시 합쳐질 때까지 이 노선을 간다.","links":["달구지"],"day":6},{"id":"n46","type":"사건","title":"오지 않은 다음 차","body":"부모님이 아이의 보호 경로를 지키기 위해 이송에 응했음을 확인했다.","links":[],"day":6},{"id":"n47","type":"인물","title":"빈칸을 물려받은 집","body":"노인의 증조모·할머니·어머니의 이송표. 사유는 없지만 노인은 세 사람의 삶을 기억했다.","links":["서울 추방"],"day":6},{"id":"n48","type":"사건","title":"호송 기록: 잠든 자동 검문소","body":"지형: 좁은 국도와 폐차 차양, 고장 난 차단봉\n처음 목표: 다섯 수레를 기록 없이 통과시킨다\n실패 위험: 행렬이 끊기면 센서가 사람 수를 센다\n읽어낸 틈: 센서가 놓치는 한 박자의 정지\n행렬 세우기 — 정찰: 폐차 차양 아래에서 통과 순서를 맞춘다\n센서 속이기 — 지휘: 각 수레의 움직임을 손신호로 맞춘다\n통과시키기 — 인력 릴레이: 짐 높이를 낮추고 전원이 손으로 넘긴다\n결과: 목표 달성. 차체 83/100, 관측 1/5.","links":["달구지","천리안"],"day":7}],"noteSeq":49,"npcs":{"geumja":{"att":15,"met":true,"chat":[]},"sundeok":{"att":0,"met":false,"chat":[]},"taeho":{"att":0,"met":false,"chat":[]},"jaepil":{"att":15,"met":true,"chat":[]},"miyoung":{"att":17,"met":true,"chat":[]},"drhan":{"att":0,"met":false,"chat":[]},"deokgu":{"att":0,"met":false,"chat":[]},"suwan":{"att":11,"met":true,"chat":[]},"byungchul":{"att":0,"met":false,"chat":[]},"yeongok":{"att":0,"met":false,"chat":[]},"sera":{"att":0,"met":false,"chat":[]},"mansu":{"att":0,"met":