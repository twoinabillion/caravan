[0:v]trim=start=2:end=2.40,setpts=PTS-STARTPTS,tpad=stop_mode=clone:stop=115,setpts=N/25/TB[intro];
[0:v]setpts=PTS-STARTPTS[play];
[0:v]trim=start=48:end=48.40,setpts=PTS-STARTPTS,tpad=stop_mode=clone:stop=125,setpts=N/25/TB[outro];
[intro][play][outro]concat=n=3:v=1:a=0,fps=30,split=2[bg][fg];
[bg]scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080,gblur=sigma=42,eq=brightness=-0.34:saturation=0.5[bg1];
[fg]scale=-2:940[fg1];
[bg1][fg1]overlay=(W-w)/2:70[composed];
